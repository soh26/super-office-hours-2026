# Copy to .dev.vars for local `wrangler pages dev` (functions/api/*.js read this via context.env)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo (formerly Sendinblue) Transactional Email API (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=tickets@takeoff-tokyo.com
BREVO_SENDER_NAME=Super Office Hours

# Supabase (Project URL and Service Role / Secret key for backend writes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
