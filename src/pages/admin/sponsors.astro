  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  // @ts-nocheck
  (function () {
    const STORAGE_KEY = "soh_admin_password";

    // DOM Elements
    const lockView = document.getElementById("lockView");
    const dashboardView = document.getElementById("dashboardView");
    const authActions = document.getElementById("authActions");
    const loginForm = document.getElementById("loginForm");
    const adminPasswordInput = document.getElementById("adminPassword");
    const authError = document.getElementById("authError");
    const logoutBtn = document.getElementById("logoutBtn");

    const createSponsorForm = document.getElementById("createSponsorForm");
    const sponsorNameInput = document.getElementById("sponsorName");
    const sponsorSlugInput = document.getElementById("sponsorSlug");
    const sponsorCurrencyInput = document.getElementById("sponsorCurrency");
    const sponsorCurrencyPrefix = document.getElementById("sponsorCurrencyPrefix");
    const sponsorAmountInput = document.getElementById("sponsorAmount");
    const urlPreview = document.getElementById("urlPreview");
    const createPerksList = document.getElementById("createPerksList");
    const createSubmitBtn = document.getElementById("createSubmitBtn");
    const createSpinner = document.getElementById("createSpinner");
    const createText = document.getElementById("createText");
    const createFormError = document.getElementById("createFormError");

    const createdBanner = document.getElementById("createdBanner");
    const createdUrlInput = document.getElementById("createdUrlInput");
    const copyCreatedUrlBtn = document.getElementById("copyCreatedUrlBtn");
    const testCreatedUrlLink = document.getElementById("testCreatedUrlLink");

    const refreshBtn = document.getElementById("refreshBtn");
    const sponsorsTbody = document.getElementById("sponsorsTbody");

    // Dialogs
    const editDialog = document.getElementById("editDialog");
    const editSponsorForm = document.getElementById("editSponsorForm");
    const editSponsorId = document.getElementById("editSponsorId");
    const editSponsorName = document.getElementById("editSponsorName");
    const editSponsorSlug = document.getElementById("editSponsorSlug");
    const editSponsorCurrencyInput = document.getElementById("editSponsorCurrency");
    const editSponsorCurrencyPrefix = document.getElementById("editSponsorCurrencyPrefix");
    const editSponsorAmount = document.getElementById("editSponsorAmount");
    const editUrlPreview = document.getElementById("editUrlPreview");
    const editPerksList = document.getElementById("editPerksList");
    const editFormError = document.getElementById("editFormError");
    const saveEditBtn = document.getElementById("saveEditBtn");
    const editSpinner = document.getElementById("editSpinner");
    const editText = document.getElementById("editText");

    const deleteDialog = document.getElementById("deleteDialog");
    const deleteDialogDesc = document.getElementById("deleteDialogDesc");
    const deleteDialogError = document.getElementById("deleteDialogError");
    const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
    const deleteSpinner = document.getElementById("deleteSpinner");
    const deleteBtnText = document.getElementById("deleteBtnText");

    const viewsDialog = document.getElementById("viewsDialog");
    const viewsDialogTitle = document.getElementById("viewsDialogTitle");
    const viewsDialogSubtitle = document.getElementById("viewsDialogSubtitle");
    const viewsTotalCount = document.getElementById("viewsTotalCount");
    const viewsUniqueCities = document.getElementById("viewsUniqueCities");
    const viewsLastAccessed = document.getElementById("viewsLastAccessed");
    const viewsTbody = document.getElementById("viewsTbody");
    const refreshViewsBtn = document.getElementById("refreshViewsBtn");
    let activeViewsSponsorId = null;

    // In-memory data store
    let sponsorsCache = [];
    let activeDeleteId = null;

    // Helpers
    function formatRelativeTime(date) {
      const now = new Date();
      const diffMs = now - date;
      const diffSec = Math.floor(diffMs / 1000);
      if (diffSec < 60) return "just now";
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) return `${diffMin}m ago`;
      const diffHour = Math.floor(diffMin / 60);
      if (diffHour < 24) return `${diffHour}h ago`;
      const diffDay = Math.floor(diffHour / 24);
      if (diffDay < 30) return `${diffDay}d ago`;
      return date.toLocaleDateString();
    }

    function getCurrencySymbol(curr) {
      const code = String(curr || "jpy").toLowerCase();
      if (code === "usd") return "$";
      if (code === "eur") return "€";
      return "¥";
    }

    function formatAmountDisplay(amount, curr) {
      const code = String(curr || "jpy").toLowerCase();
      const num = Number(amount || 0);
      const symbol = getCurrencySymbol(code);
      if (code === "jpy") {
        return `${symbol}${Math.round(num).toLocaleString("en-US")} JPY`;
      }
      return `${symbol}${num.toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 2 })} ${code.toUpperCase()}`;
    }

    if (sponsorCurrencyInput && sponsorCurrencyPrefix) {
      sponsorCurrencyInput.addEventListener("change", () => {
        const val = sponsorCurrencyInput.value;
        sponsorCurrencyPrefix.textContent = getCurrencySymbol(val);
        if (val === "jpy") {
          sponsorAmountInput.placeholder = "300000";
        } else {
          sponsorAmountInput.placeholder = "2500";
        }
      });
    }

    if (editSponsorCurrencyInput && editSponsorCurrencyPrefix) {
      editSponsorCurrencyInput.addEventListener("change", () => {
        const val = editSponsorCurrencyInput.value;
        editSponsorCurrencyPrefix.textContent = getCurrencySymbol(val);
        if (val === "jpy") {
          editSponsorAmount.placeholder = "300000";
        } else {
          editSponsorAmount.placeholder = "2500";
        }
      });
    }

    function escapeHtml(str) {
      return String(str || "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      })[c]);
    }

    function slugify(text) {
      return String(text || "")
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9_-]/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    function getApiUrl(path) {
      const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
      if (isLocal && window.location.port !== "8787") {
        return `http://${window.location.hostname}:8787${path}`;
      }
      return path;
    }

    function getStoredPassword() {
      return sessionStorage.getItem(STORAGE_KEY) || "";
    }

    function showDashboard() {
      lockView.classList.add("hidden");
      dashboardView.classList.remove("hidden");
      authActions.classList.remove("hidden");
      updateCreateUrlPreview();
      loadSponsors();
    }

    function showLock() {
      lockView.classList.remove("hidden");
      dashboardView.classList.add("hidden");
      authActions.classList.add("hidden");
      sessionStorage.removeItem(STORAGE_KEY);
      adminPasswordInput.value = "";
    }

    // Perks Dynamic Rows Helpers
    function appendPerkRow(target, initialValue = "", insertAfterRow = null) {
      const listEl = target === "edit" ? editPerksList : createPerksList;
      if (!listEl) return;

      const row = document.createElement("div");
      row.className = "perk-row";
      row.innerHTML = `
        <span class="perk-prefix" aria-hidden="true">&#10003;</span>
        <input
          type="text"
          class="perk-input"
          placeholder="e.g. 4 VIP Executive Passes at Dragon Gate"
          value="${escapeHtml(initialValue)}"
        />
        <button
          type="button"
          class="remove-perk-btn"
          data-action="remove-perk"
          title="Remove Entry"
          aria-label="Remove Entry"
        >&times;</button>
      `;

      if (insertAfterRow && insertAfterRow.nextElementSibling) {
        listEl.insertBefore(row, insertAfterRow.nextElementSibling);
      } else {
        listEl.appendChild(row);
      }

      const input = row.querySelector(".perk-input");
      if (input) {
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            appendPerkRow(target, "", row);
          } else if (e.key === "Backspace" && !input.value) {
            const rows = listEl.querySelectorAll(".perk-row");
            if (rows.length > 1) {
              e.preventDefault();
              const prevRow = row.previousElementSibling || row.nextElementSibling;
              row.remove();
              if (prevRow) {
                const prevInput = prevRow.querySelector(".perk-input");
                if (prevInput) prevInput.focus();
              }
            }
          }
        });
        if (!initialValue) {
          input.focus();
        }
      }

      return row;
    }

    // Live URL Preview helpers
    function updateCreateUrlPreview() {
      const slug = slugify(sponsorSlugInput.value.trim() || sponsorNameInput.value.trim() || "sponsor-name");
      urlPreview.textContent = `${window.location.origin}/thanks-${slug}`;
    }

    function updateEditUrlPreview() {
      const slug = slugify(editSponsorSlug.value.trim() || editSponsorName.value.trim() || "sponsor-name");
      editUrlPreview.textContent = `${window.location.origin}/thanks-${slug}`;
    }

    sponsorNameInput.addEventListener("input", () => {
      if (!sponsorSlugInput.dataset.manual) {
        sponsorSlugInput.value = slugify(sponsorNameInput.value);
      }
      updateCreateUrlPreview();
    });

    sponsorSlugInput.addEventListener("input", () => {
      sponsorSlugInput.dataset.manual = "true";
      updateCreateUrlPreview();
    });

    editSponsorName.addEventListener("input", () => {
      if (!editSponsorSlug.dataset.manual) {
        editSponsorSlug.value = slugify(editSponsorName.value);
      }
      updateEditUrlPreview();
    });

    editSponsorSlug.addEventListener("input", () => {
      editSponsorSlug.dataset.manual = "true";
      updateEditUrlPreview();
    });

    // Login Form Submit
    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      authError.classList.add("hidden");
      const password = adminPasswordInput.value.trim();

      try {
        const res = await fetch(getApiUrl("/api/admin/verify"), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Authentication failed");
        }

        sessionStorage.setItem(STORAGE_KEY, password);
        showDashboard();
      } catch (err) {
        let msg = err.message || "Invalid password";
        const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        if (err.name === "TypeError" && isLocal && window.location.port === "4321") {
          msg = "Cannot connect to Cloudflare Functions on port 8787. Please ensure 'npm run dev:functions' is running.";
        }
        authError.textContent = msg;
        authError.classList.remove("hidden");
      }
    });

    logoutBtn.addEventListener("click", showLock);
    refreshBtn.addEventListener("click", loadSponsors);

    // Load Sponsors Table Data
    async function loadSponsors() {
      const password = getStoredPassword();
      if (!password) return showLock();

      sponsorsTbody.innerHTML = `
        <tr><td colspan="6" class="table-empty-cell">Loading sponsors...</td></tr>
      `;

      try {
        const res = await fetch(getApiUrl("/api/admin/sponsors"), {
          headers: { Authorization: `Bearer ${password}` },
        });

        if (res.status === 401) {
          return showLock();
        }

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Failed to load sponsors");
        }

        const sponsors = data.sponsors || [];
        sponsorsCache = sponsors;

        if (sponsors.length === 0) {
          sponsorsTbody.innerHTML = `
            <tr><td colspan="7" class="table-empty-cell">No sponsor links created yet. Use the form above to generate one!</td></tr>
          `;
          return;
        }

        const origin = window.location.origin;
        sponsorsTbody.innerHTML = sponsors.map((s) => {
          const url = s.url || `${origin}/thanks-${s.slug}`;
          const isPaid = s.status === "paid";
          const statusClass = isPaid ? "status-paid" : "status-pending";
          const formattedAmount = formatAmountDisplay(s.amount, s.currency);
          const dateStr = s.created_at ? new Date(s.created_at).toLocaleDateString() : "-";

          const viewsCount = Number(s.view_count) || (Array.isArray(s.views) ? s.views.length : 0);
          const viewsLabel = viewsCount === 1 ? "1 view" : `${viewsCount} views`;
          const viewsHtml = viewsCount > 0
            ? `<button type="button" class="badge-views-active" data-action="open-views" data-id="${escapeHtml(s.id)}" title="Click to view access logs">👁️ ${viewsLabel}</button>`
            : `<button type="button" class="badge-views-zero" data-action="open-views" data-id="${escapeHtml(s.id)}" style="background:none;border:none;cursor:pointer;" title="View access logs">0 views</button>`;

          let actionsHtml = "";
          if (isPaid) {
            actionsHtml = `
              <div class="action-btn-group">
                <button type="button" class="btn btn-sm btn-secondary" data-action="open-views" data-id="${escapeHtml(s.id)}" title="View Access Logs">Logs</button>
                <span class="action-locked-badge" title="Payment completed. Edit/Delete actions are locked for paid sponsors.">
                  🔒 Paid
                </span>
              </div>
            `;
          } else {
            actionsHtml = `
              <div class="action-btn-group">
                <button type="button" class="btn btn-sm btn-secondary" data-action="copy-link" data-url="${escapeHtml(url)}" title="Copy Link">Copy</button>
                <button type="button" class="btn btn-sm btn-secondary" data-action="open-views" data-id="${escapeHtml(s.id)}" title="View Access Logs">Logs</button>
                <button type="button" class="btn btn-sm btn-secondary" data-action="open-edit" data-id="${escapeHtml(s.id)}" title="Edit Pending Sponsor">Edit</button>
                <button type="button" class="btn btn-sm btn-danger" data-action="open-delete" data-id="${escapeHtml(s.id)}" title="Delete Pending Sponsor">Delete</button>
              </div>
            `;
          }

          return `
            <tr>
              <td><strong style="color:#fff;">${escapeHtml(s.name)}</strong></td>
              <td><a href="${escapeHtml(url)}" target="_blank" style="color:#2dd4bf;text-decoration:none;font-family:monospace;font-size:0.85rem;">/thanks-${escapeHtml(s.slug)}</a></td>
              <td><strong style="color:#fff;">${formattedAmount}</strong></td>
              <td><span class="status-badge ${statusClass}">${isPaid ? "Paid ✓" : "Pending"}</span></td>
              <td>${viewsHtml}</td>
              <td style="color:rgba(255,255,255,0.5);font-size:0.85rem;">${dateStr}</td>
              <td style="text-align:right;">${actionsHtml}</td>
            </tr>
          `;
        }).join("");
      } catch (err) {
        sponsorsTbody.innerHTML = `
          <tr><td colspan="7" class="table-empty-cell" style="color:#f87171;">Failed to load sponsors: ${escapeHtml(err.message)}</td></tr>
        `;
      }
    }

    // Modal Operations: Access Logs
    async function openViewsModal(id) {
      const sponsor = sponsorsCache.find((s) => String(s.id) === String(id));
      if (!sponsor) {
        alert("Sponsor not found.");
        return;
      }

      activeViewsSponsorId = sponsor.id;
      viewsDialogTitle.textContent = `Access Logs: ${sponsor.name}`;
      viewsDialogSubtitle.textContent = `Live views for /thanks-${sponsor.slug}`;

      renderViewsList(sponsor.views || [], Number(sponsor.view_count) || (sponsor.views?.length || 0));

      if (typeof viewsDialog.showModal === "function") {
        viewsDialog.showModal();
      } else {
        viewsDialog.setAttribute("open", "");
      }

      fetchSponsorLogs(sponsor.id);
    }

    function renderViewsList(views, totalCount) {
      const total = totalCount || (views ? views.length : 0);
      viewsTotalCount.textContent = total;

      const safeViews = Array.isArray(views) ? views : [];
      const cities = new Set(safeViews.map((v) => v.city).filter((c) => c && c !== "Unknown"));
      viewsUniqueCities.textContent = cities.size;

      if (safeViews.length === 0) {
        viewsLastAccessed.textContent = "-";
        viewsTbody.innerHTML = `
          <tr>
            <td colspan="2" class="table-empty-cell" style="padding:2rem 1rem;">
              No views recorded yet for this sponsor link.<br/>
              When a user accesses the link, their timestamp and city will appear here automatically.
            </td>
          </tr>
        `;
        return;
      }

      const latestDate = new Date(safeViews[0].timestamp);
      viewsLastAccessed.textContent = !isNaN(latestDate.getTime()) ? formatRelativeTime(latestDate) : "-";

      viewsTbody.innerHTML = safeViews.map((v) => {
        const d = new Date(v.timestamp);
        const formattedDate = isNaN(d.getTime()) ? (v.timestamp || "-") : d.toLocaleString();
        const rel = isNaN(d.getTime()) ? "" : formatRelativeTime(d);
        const cityStr = v.city || "Unknown";
        let locationStr = cityStr;
        if (v.country && cityStr !== "Unknown") {
          if (cityStr.includes("(") || cityStr.includes("（")) {
            locationStr = cityStr;
          } else {
            locationStr = `${cityStr}, ${v.country}`;
          }
        }

        return `
          <tr>
            <td>
              <strong style="color:#fff;">${escapeHtml(formattedDate)}</strong>
              ${rel ? `<span class="log-time-relative">(${escapeHtml(rel)})</span>` : ""}
            </td>
            <td>
              <span style="color:#2dd4bf;margin-right:0.35rem;">📍</span>
              <strong style="color:${cityStr === "Unknown" ? "rgba(255,255,255,0.45)" : "#fff"};">${escapeHtml(locationStr)}</strong>
            </td>
          </tr>
        `;
      }).join("");
    }

    async function fetchSponsorLogs(id) {
      const password = getStoredPassword();
      if (!password) return;

      try {
        const res = await fetch(getApiUrl(`/api/admin/sponsors?logs=${encodeURIComponent(id)}`), {
          headers: { Authorization: `Bearer ${password}` },
        });
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data.views)) {
            const sp = sponsorsCache.find((s) => String(s.id) === String(id));
            if (sp) {
              sp.views = data.views;
              if (data.views.length > (sp.view_count || 0)) {
                sp.view_count = data.views.length;
              }
            }
            renderViewsList(data.views, sp ? sp.view_count : data.views.length);
          }
        }
      } catch (err) {
        console.warn("Failed to fetch fresh sponsor logs:", err.message);
      }
    }

    if (refreshViewsBtn) {
      refreshViewsBtn.addEventListener("click", () => {
        if (activeViewsSponsorId) {
          fetchSponsorLogs(activeViewsSponsorId);
        }
      });
    }

    // Modal Operations
    function openEditModal(id) {
      const sponsor = sponsorsCache.find((s) => String(s.id) === String(id));
      if (!sponsor) {
        alert("Sponsor not found.");
        return;
      }

      if (sponsor.status === "paid") {
        alert("This sponsor has completed payment. No actions are permitted on paid sponsors.");
        return;
      }

      editSponsorId.value = sponsor.id;
      editSponsorName.value = sponsor.name || "";
      editSponsorSlug.value = sponsor.slug || "";
      editSponsorSlug.dataset.manual = "true";
      editSponsorAmount.value = sponsor.amount || "";
      if (editSponsorCurrencyInput) {
        const curr = (sponsor.currency || "jpy").toLowerCase();
        editSponsorCurrencyInput.value = curr;
        if (editSponsorCurrencyPrefix) editSponsorCurrencyPrefix.textContent = getCurrencySymbol(curr);
        if (curr === "jpy") {
          editSponsorAmount.placeholder = "300000";
        } else {
          editSponsorAmount.placeholder = "2500";
        }
      }
      editFormError.classList.add("hidden");

      updateEditUrlPreview();

      editPerksList.innerHTML = "";
      const perks = Array.isArray(sponsor.metadata?.perks)
        ? sponsor.metadata.perks
        : (sponsor.description ? sponsor.description.split("\n").map((p) => p.trim()).filter(Boolean) : []);

      if (perks.length > 0) {
        perks.forEach((p) => appendPerkRow("edit", p));
      } else {
        appendPerkRow("edit", "");
      }

      if (typeof editDialog.showModal === "function") {
        editDialog.showModal();
      } else {
        editDialog.setAttribute("open", "");
      }
    }

    function openDeleteModal(id) {
      const sponsor = sponsorsCache.find((s) => String(s.id) === String(id));
      if (!sponsor) {
        alert("Sponsor not found.");
        return;
      }

      if (sponsor.status === "paid") {
        alert("This sponsor has completed payment. No actions are permitted on paid sponsors.");
        return;
      }

      activeDeleteId = sponsor.id;
      deleteDialogDesc.innerHTML = `Are you sure you want to delete the pending sponsor link for <strong>${escapeHtml(sponsor.name)}</strong> (${formatAmountDisplay(sponsor.amount, sponsor.currency)})? This link will no longer be accessible.`;
      deleteDialogError.classList.add("hidden");

      if (typeof deleteDialog.showModal === "function") {
        deleteDialog.showModal();
      } else {
        deleteDialog.setAttribute("open", "");
      }
    }

    function closeDialog(dialogEl) {
      if (!dialogEl) return;
      if (typeof dialogEl.close === "function") {
        dialogEl.close();
      } else {
        dialogEl.removeAttribute("open");
      }
      if (dialogEl === deleteDialog) activeDeleteId = null;
      if (dialogEl === viewsDialog) activeViewsSponsorId = null;
    }

    // Global Click Delegation (Handles All Actions Robustly)
    document.addEventListener("click", (e) => {
      // Remove Perk Row
      const removeBtn = e.target.closest('[data-action="remove-perk"]');
      if (removeBtn) {
        e.preventDefault();
        const row = removeBtn.closest(".perk-row");
        if (row) {
          const parentList = row.parentElement;
          const target = parentList === editPerksList ? "edit" : "create";
          row.remove();
          if (parentList.querySelectorAll(".perk-row").length === 0) {
            appendPerkRow(target, "");
          }
        }
        return;
      }

      // Copy Link Button
      const copyBtn = e.target.closest('[data-action="copy-link"]');
      if (copyBtn) {
        e.preventDefault();
        const url = copyBtn.getAttribute("data-url");
        if (url) {
          navigator.clipboard.writeText(url).then(() => {
            const orig = copyBtn.textContent;
            copyBtn.textContent = "Copied!";
            setTimeout(() => { copyBtn.textContent = orig; }, 2000);
          });
        }
        return;
      }

      // Open Views Modal
      const viewsBtn = e.target.closest('[data-action="open-views"]');
      if (viewsBtn) {
        e.preventDefault();
        const id = viewsBtn.getAttribute("data-id");
        if (id) openViewsModal(id);
        return;
      }

      // Open Edit Modal
      const editBtn = e.target.closest('[data-action="open-edit"]');
      if (editBtn) {
        e.preventDefault();
        const id = editBtn.getAttribute("data-id");
        if (id) openEditModal(id);
        return;
      }

      // Open Delete Modal
      const delBtn = e.target.closest('[data-action="open-delete"]');
      if (delBtn) {
        e.preventDefault();
        const id = delBtn.getAttribute("data-id");
        if (id) openDeleteModal(id);
        return;
      }

      // Close Dialog
      const closeBtn = e.target.closest('[data-action="close-dialog"]');
      if (closeBtn) {
        e.preventDefault();
        const dialogId = closeBtn.getAttribute("data-dialog");
        const dialogEl = document.getElementById(dialogId);
        closeDialog(dialogEl);
        return;
      }
    });

    // Close Dialog on backdrop click
    editDialog.addEventListener("click", (e) => {
      if (e.target === editDialog) closeDialog(editDialog);
    });
    deleteDialog.addEventListener("click", (e) => {
      if (e.target === deleteDialog) closeDialog(deleteDialog);
    });
    viewsDialog.addEventListener("click", (e) => {
      if (e.target === viewsDialog) closeDialog(viewsDialog);
    });

    // Create Sponsor Form Submit
    createSponsorForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      createFormError.classList.add("hidden");
      createdBanner.classList.add("hidden");

      const password = getStoredPassword();
      if (!password) return showLock();

      createSubmitBtn.disabled = true;
      createSpinner.classList.remove("hidden");
      createText.textContent = "Creating sponsor link...";

      const name = sponsorNameInput.value.trim();
      const slug = slugify(sponsorSlugInput.value.trim() || name);
      const currency = sponsorCurrencyInput ? sponsorCurrencyInput.value : "jpy";
      const amount = Number(sponsorAmountInput.value);
      const perks = Array.from(createPerksList.querySelectorAll(".perk-input"))
        .map((el) => el.value.trim())
        .filter(Boolean);

      try {
        const res = await fetch(getApiUrl("/api/admin/sponsors"), {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${password}`,
          },
          body: JSON.stringify({ name, slug, amount, currency, perks }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Failed to create sponsor link");
        }

        // Show banner
        createdUrlInput.value = data.url;
        testCreatedUrlLink.href = data.url;
        createdBanner.classList.remove("hidden");
        createdBanner.scrollIntoView({ behavior: "smooth" });

        // Reset form
        createSponsorForm.reset();
        if (sponsorCurrencyInput) {
          sponsorCurrencyInput.value = "jpy";
          if (sponsorCurrencyPrefix) sponsorCurrencyPrefix.textContent = "¥";
          sponsorAmountInput.placeholder = "300000";
        }
        createPerksList.innerHTML = "";
        appendPerkRow("create", "");
        delete sponsorSlugInput.dataset.manual;
        updateCreateUrlPreview();

        loadSponsors();
      } catch (err) {
        createFormError.textContent = err.message || "An error occurred";
        createFormError.classList.remove("hidden");
      } finally {
        createSubmitBtn.disabled = false;
        createSpinner.classList.add("hidden");
        createText.textContent = "Generate Custom Sponsor Link →";
      }
    });

    // Copy from created banner
    copyCreatedUrlBtn.addEventListener("click", () => {
      createdUrlInput.select();
      navigator.clipboard.writeText(createdUrlInput.value).then(() => {
        copyCreatedUrlBtn.textContent = "Copied!";
        setTimeout(() => { copyCreatedUrlBtn.textContent = "Copy Link"; }, 2000);
      });
    });

    // Edit Sponsor Form Submit (PUT)
    editSponsorForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      editFormError.classList.add("hidden");
      saveEditBtn.disabled = true;
      editSpinner.classList.remove("hidden");
      editText.textContent = "Saving Changes...";

      const password = getStoredPassword();
      const id = editSponsorId.value;
      const name = editSponsorName.value.trim();
      const slug = slugify(editSponsorSlug.value.trim() || name);
      const currency = editSponsorCurrencyInput ? editSponsorCurrencyInput.value : "jpy";
      const amount = Number(editSponsorAmount.value);
      const perks = Array.from(editPerksList.querySelectorAll(".perk-input"))
        .map((input) => input.value.trim())
        .filter(Boolean);

      try {
        const res = await fetch(getApiUrl("/api/admin/sponsors"), {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${password}`,
          },
          body: JSON.stringify({ id, name, slug, amount, currency, perks }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Failed to update sponsor link");
        }

        closeDialog(editDialog);
        loadSponsors();
      } catch (err) {
        editFormError.textContent = err.message || "An error occurred";
        editFormError.classList.remove("hidden");
      } finally {
        saveEditBtn.disabled = false;
        editSpinner.classList.add("hidden");
        editText.textContent = "Save Changes →";
      }
    });

    // Confirm Delete Sponsor (DELETE)
    confirmDeleteBtn.addEventListener("click", async () => {
      if (!activeDeleteId) return;

      confirmDeleteBtn.disabled = true;
      deleteSpinner.classList.remove("hidden");
      deleteBtnText.textContent = "Deleting...";

      const password = getStoredPassword();

      try {
        const res = await fetch(getApiUrl(`/api/admin/sponsors?id=${encodeURIComponent(activeDeleteId)}`), {
          method: "DELETE",
          headers: { Authorization: `Bearer ${password}` },
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Failed to delete sponsor link");
        }

        closeDialog(deleteDialog);
        loadSponsors();
      } catch (err) {
        deleteDialogError.textContent = err.message || "Failed to delete sponsor";
        deleteDialogError.classList.remove("hidden");
      } finally {
        confirmDeleteBtn.disabled = false;
        deleteSpinner.classList.add("hidden");
        deleteBtnText.textContent = "Delete Sponsor";
      }
    });

    // Initialize initial empty perk row
    appendPerkRow("create", "");

    // Auto-login if password cached in session
    if (getStoredPassword()) {
      showDashboard();
    }
  })();
</script>
