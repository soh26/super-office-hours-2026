---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sponsor Link Management — Super Office Hours">
  <div class="admin-wrapper">
    <!-- Top Navigation -->
    <header class="admin-header">
      <div class="admin-header-inner">
        <a href="/" class="admin-logo" aria-label="Takeoff Tokyo — home">
          <img src="/images/takeoff-tokyo-logo.png" alt="Takeoff Tokyo" height="26" style="height:26px;width:auto;" />
          <span class="admin-tag">Admin</span>
        </a>
        <div id="authActions" style="display:none;">
          <button id="logoutBtn" class="btn btn-ghost">Lock Dashboard</button>
        </div>
      </div>
    </header>

    <!-- 1. Password Lock Overlay (Shown when unauthenticated) -->
    <div id="lockView" class="auth-center">
      <div class="auth-card">
        <div class="auth-icon">🔒</div>
        <h2>Organizer Access</h2>
        <p class="auth-desc">Enter the sponsor administration password to manage custom sponsor payment links.</p>

        <form id="loginForm">
          <div class="form-group">
            <label for="adminPassword">Password</label>
            <input
              type="password"
              id="adminPassword"
              class="input-field"
              placeholder="Enter password"
              autocomplete="current-password"
              required
            />
          </div>
          <div id="authError" class="alert-error" style="display:none;"></div>
          <button type="submit" id="unlockBtn" class="btn btn-primary" style="width:100%;margin-top:1.25rem;">
            Unlock Dashboard &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- 2. Admin Dashboard (Revealed after successful password verification) -->
    <main id="dashboardView" class="dashboard-container" style="display:none;">
      <div class="dashboard-head">
        <div>
          <h1>Custom Sponsor Checkouts</h1>
          <p class="text-muted">Create tailored Stripe links for sponsors.</p>
        </div>
      </div>

      <!-- Link Creation Form Card -->
      <section class="card form-card">
        <div class="card-header">
          <div class="card-badge">Step 1</div>
          <h2>New Sponsor Link</h2>
          <p class="card-subtitle">Each sponsor receives a dedicated checkout URL with their agreed sponsorship amount.</p>
        </div>

        <form id="createSponsorForm" class="create-form">
          <div class="grid-2">
            <div class="form-group">
              <label for="sponsorName">Company Name <span class="req">*</span></label>
              <input
                type="text"
                id="sponsorName"
                class="input-field"
                placeholder="e.g. Acme Innovations Inc."
                required
              />
            </div>

            <div class="form-group">
              <label for="sponsorSlug">Custom URL Slug <span class="req">*</span></label>
              <input
                type="text"
                id="sponsorSlug"
                class="input-field"
                placeholder="e.g. acme-innovations"
                required
              />
            </div>
          </div>

          <!-- Live URL Preview -->
          <div class="url-preview-box">
            <span class="url-preview-label">Generated Sponsor URL:</span>
            <code id="urlPreview">https://soh.takeoff-tokyo.com/thanks-acme-innovations</code>
          </div>

          <div class="form-group" style="margin-top:1.25rem;">
            <label for="sponsorAmount">Amount (JPY) <span class="req">*</span></label>
            <div class="input-prefix-wrapper">
              <span class="input-prefix">¥</span>
              <input
                type="number"
                id="sponsorAmount"
                class="input-field with-prefix"
                placeholder="300000"
                min="50"
                step="1"
                required
              />
            </div>
          </div>

          <!-- Package / Invoice Description (Explicit Entries Only) -->
          <div class="form-group" style="margin-top:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
              <label style="margin-bottom:0;">Package Description</label>
              <button type="button" id="addPerkBtn" class="add-perk-btn">
                <span class="plus-icon">+</span> Add Entry
              </button>
            </div>
            <span class="field-hint" style="margin-top:0;margin-bottom:0.75rem;">
              Enter each addon/perk as an explicit entry.
            </span>
            <div id="perksEmptyNote" class="perks-empty-note">
              No custom perks added. Click <strong>+ Add Entry</strong> to specify inclusions, or leave empty for no addons.
            </div>
            <div id="perksList" class="perks-list">
              <!-- Input tags dynamically added here -->
            </div>
          </div>

          <div id="formError" class="alert-error" style="display:none;margin-top:1rem;"></div>

          <div class="form-actions">
            <button type="submit" id="submitBtn" class="btn btn-accent">
              <span id="submitSpinner" class="spinner" style="display:none;"></span>
              <span id="submitText">Generate Custom Sponsor Link &rarr;</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Success Notification Box (Populated after link creation) -->
      <section id="createdAlert" class="card success-banner" style="display:none;">
        <div class="success-banner-inner">
          <div class="success-icon">✓</div>
          <div class="success-content">
            <h3>Sponsor Link Created!</h3>
            <p>Send this custom link directly to the sponsor representative:</p>
            <div class="copy-url-row">
              <input type="text" id="createdUrlInput" class="input-field copy-field" readonly />
              <button type="button" id="copyUrlBtn" class="btn btn-secondary">Copy Link</button>
              <a id="testUrlLink" href="#" target="_blank" class="btn btn-ghost">Open Page &nearr;</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Existing Sponsors Table -->
      <section class="card table-card" style="margin-top:2.5rem;">
        <div class="table-header">
          <div>
            <h2>Track Existing Sponsor Links</h2>
          </div>
          <button type="button" id="refreshBtn" class="btn btn-sm btn-ghost">Refresh List</button>
        </div>

        <div class="table-responsive">
          <table class="sponsor-table">
            <thead>
              <tr>
                <th>Sponsor Name</th>
                <th>Custom URL</th>
                <th>Amount (JPY)</th>
                <th>Payment Status</th>
                <th>Created</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody id="sponsorsTbody">
              <tr>
                <td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted);">
                  Loading sponsors...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- Edit Pending Sponsor Modal -->
    <div id="editModal" class="modal-overlay" style="display:none;">
      <div class="modal-card">
        <div class="modal-header">
          <div>
            <div class="card-badge">Edit Pending Sponsor</div>
            <h2 id="editModalTitle">Edit Sponsor Link</h2>
            <p class="card-subtitle" style="margin-bottom:0;">Update package details for this pending sponsorship.</p>
          </div>
          <button type="button" id="closeEditModalBtn" class="close-modal-btn" aria-label="Close modal">&times;</button>
        </div>

        <form id="editSponsorForm" class="create-form">
          <input type="hidden" id="editSponsorId" />

          <div class="grid-2">
            <div class="form-group">
              <label for="editSponsorName">Company Name <span class="req">*</span></label>
              <input
                type="text"
                id="editSponsorName"
                class="input-field"
                placeholder="e.g. Acme Innovations Inc."
                required
              />
            </div>

            <div class="form-group">
              <label for="editSponsorSlug">Custom URL Slug <span class="req">*</span></label>
              <input
                type="text"
                id="editSponsorSlug"
                class="input-field"
                placeholder="e.g. acme-innovations"
                required
              />
            </div>
          </div>

          <!-- Live URL Preview -->
          <div class="url-preview-box">
            <span class="url-preview-label">URL Preview:</span>
            <code id="editUrlPreview">https://soh.takeoff-tokyo.com/thanks-...</code>
          </div>

          <div class="form-group" style="margin-top:1.25rem;">
            <label for="editSponsorAmount">Amount (JPY) <span class="req">*</span></label>
            <div class="input-prefix-wrapper">
              <span class="input-prefix">¥</span>
              <input
                type="number"
                id="editSponsorAmount"
                class="input-field with-prefix"
                placeholder="300000"
                min="50"
                step="1"
                required
              />
            </div>
          </div>

          <!-- Package / Invoice Description (Explicit Entries Only) -->
          <div class="form-group" style="margin-top:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.4rem;">
              <label style="margin-bottom:0;">Package Description</label>
              <button type="button" id="editAddPerkBtn" class="add-perk-btn">
                <span class="plus-icon">+</span> Add Entry
              </button>
            </div>
            <span class="field-hint" style="margin-top:0;margin-bottom:0.75rem;">
              Enter each addon/perk as an explicit entry.
            </span>
            <div id="editPerksEmptyNote" class="perks-empty-note">
              No custom perks added. Click <strong>+ Add Entry</strong> to specify inclusions, or leave empty for no addons.
            </div>
            <div id="editPerksList" class="perks-list">
              <!-- Edit input tags dynamically added here -->
            </div>
          </div>

          <div id="editFormError" class="alert-error" style="display:none;margin-top:1rem;"></div>

          <div class="modal-actions">
            <button type="button" id="cancelEditBtn" class="btn btn-ghost">Cancel</button>
            <button type="submit" id="saveEditBtn" class="btn btn-accent">
              <span id="saveEditSpinner" class="spinner" style="display:none;"></span>
              <span id="saveEditText">Save Changes &rarr;</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal-overlay" style="display:none;">
      <div class="modal-card delete-card">
        <div class="delete-icon">⚠️</div>
        <h3>Delete Pending Sponsor Link</h3>
        <p id="deleteModalDesc" style="color:rgba(255,255,255,0.7);font-size:0.9rem;line-height:1.5;margin:0.75rem 0 1.25rem 0;">
          Are you sure you want to delete this pending sponsor link? This custom link will no longer be accessible.
        </p>
        <div id="deleteModalError" class="alert-error" style="display:none;margin-bottom:1rem;"></div>
        <div class="modal-actions" style="justify-content:center;">
          <button type="button" id="cancelDeleteBtn" class="btn btn-ghost">Cancel</button>
          <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
            <span id="deleteSpinner" class="spinner" style="display:none;"></span>
            <span id="deleteText">Delete Sponsor</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .admin-wrapper {
    min-height: 100vh;
    background: #0a0a0c;
    color: #f3f4f6;
    display: flex;
    flex-direction: column;
  }
  .admin-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 12, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .admin-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .admin-logo {
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .admin-logo span { color: #2dd4bf; }
  .admin-tag {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c084fc;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Password Lock View */
  .auth-center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
  }
  .auth-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }
  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .auth-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .auth-desc {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  /* Dashboard View */
  .dashboard-container {
    max-width: 1100px;
    margin: 2.5rem auto;
    padding: 0 1.5rem;
    width: 100%;
    flex: 1;
  }
  .dashboard-head {
    margin-bottom: 2rem;
  }
  .dashboard-head h1 {
    font-family: "TT Lakes Neue Expanded", "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 0.35rem;
  }
  .text-muted {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
  }

  /* Cards */
  .card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }
  .form-card {
    padding: 2rem;
  }
  .card-header {
    margin-bottom: 1.75rem;
  }
  .card-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #2dd4bf;
    letter-spacing: 0.06em;
    margin-bottom: 0.25rem;
  }
  .card-header h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
  }
  .card-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.88rem;
    margin-top: 0.2rem;
  }

  /* Forms */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 680px) {
    .grid-2 { grid-template-columns: 1fr; }
  }
  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 0.4rem;
  }
  .req { color: #f87171; }
  .field-hint {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 0.35rem;
  }
  .input-field {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #fff;
    font-family: inherit;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  .input-field:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
    background: rgba(255, 255, 255, 0.07);
  }
  .input-prefix-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-prefix {
    position: absolute;
    left: 1rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }
  .input-field.with-prefix {
    padding-left: 2rem;
  }

  .pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }
  .pill:hover {
    background: rgba(45, 212, 191, 0.15);
    border-color: rgba(45, 212, 191, 0.4);
    color: #2dd4bf;
  }

  /* Perks Section Styling */
  .add-perk-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(45, 212, 191, 0.1);
    border: 1px solid rgba(45, 212, 191, 0.35);
    color: #2dd4bf;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }
  .add-perk-btn:hover {
    background: rgba(45, 212, 191, 0.22);
    border-color: #2dd4bf;
    transform: translateY(-1px);
    box-shadow: 0 2px 10px rgba(45, 212, 191, 0.25);
  }
  .add-perk-btn .plus-icon {
    font-size: 1rem;
    line-height: 1;
    font-weight: 800;
  }
  .perks-empty-note {
    padding: 0.85rem 1.15rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
    line-height: 1.5;
  }
  .perks-empty-note strong {
    color: #2dd4bf;
  }
  .perks-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  /* Dynamically Injected Perks Row & Input Styles */
  :global(#perksList .perk-row),
  :global(#editPerksList .perk-row) {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    animation: perkRowFade 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes perkRowFade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  :global(#perksList .perk-prefix),
  :global(#editPerksList .perk-prefix) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(45, 212, 191, 0.12);
    border: 1px solid rgba(45, 212, 191, 0.35);
    color: #2dd4bf;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    user-select: none;
  }
  :global(#perksList .input-field),
  :global(#perksList .perk-input),
  :global(#editPerksList .input-field),
  :global(#editPerksList .perk-input) {
    flex: 1;
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: #fff;
    font-family: inherit;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  :global(#perksList .input-field:focus),
  :global(#perksList .perk-input:focus),
  :global(#editPerksList .input-field:focus),
  :global(#editPerksList .perk-input:focus) {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
    background: rgba(255, 255, 255, 0.07);
  }
  :global(#perksList .input-field::placeholder),
  :global(#perksList .perk-input::placeholder),
  :global(#editPerksList .input-field::placeholder),
  :global(#editPerksList .perk-input::placeholder) {
    color: rgba(255, 255, 255, 0.35);
  }
  :global(#perksList .remove-perk-btn),
  :global(#editPerksList .remove-perk-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #f87171;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  :global(#perksList .remove-perk-btn:hover),
  :global(#editPerksList .remove-perk-btn:hover) {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.5);
    color: #ef4444;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.25);
  }
  .url-preview-box {
    margin-top: 0.85rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .url-preview-label {
    color: rgba(255, 255, 255, 0.5);
  }
  .url-preview-box code {
    color: #2dd4bf;
    font-family: monospace;
    font-size: 0.9rem;
  }
  .form-actions {
    margin-top: 1.75rem;
    display: flex;
    justify-content: flex-end;
  }

  /* Buttons */
  .btn,
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .btn-primary,
  :global(.btn-primary) {
    background: #2dd4bf;
    color: #0a0a0c;
  }
  .btn-primary:hover,
  :global(.btn-primary:hover) {
    background: #38e6d0;
  }
  .btn-accent,
  :global(.btn-accent) {
    background: linear-gradient(135deg, #2dd4bf, #06b6d4);
    color: #0a0a0c;
    box-shadow: 0 4px 14px rgba(45, 212, 191, 0.25);
  }
  .btn-accent:hover,
  :global(.btn-accent:hover) {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .btn-secondary,
  :global(.btn-secondary) {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .btn-secondary:hover,
  :global(.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.18);
  }
  .btn-ghost,
  :global(.btn-ghost) {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .btn-ghost:hover,
  :global(.btn-ghost:hover) {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-sm,
  :global(.btn-sm) {
    padding: 0.4rem 0.85rem;
    font-size: 0.8rem;
  }

  /* Alerts */
  .alert-error {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #f87171;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.88rem;
    text-align: left;
  }
  .success-banner {
    margin-top: 1.5rem;
    padding: 1.5rem 2rem;
    background: rgba(45, 212, 191, 0.08);
    border-color: rgba(45, 212, 191, 0.3);
  }
  .success-banner-inner {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .success-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(45, 212, 191, 0.2);
    color: #2dd4bf;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
  }
  .success-content {
    flex: 1;
  }
  .success-content h3 {
    font-size: 1.15rem;
    color: #2dd4bf;
    margin-bottom: 0.25rem;
  }
  .success-content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
    margin-bottom: 0.85rem;
  }
  .copy-url-row {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .copy-field {
    flex: 1;
    min-width: 280px;
    background: rgba(0, 0, 0, 0.4);
    font-family: monospace;
    font-size: 0.9rem;
    color: #2dd4bf;
  }

  /* Table */
  .table-card {
    padding: 1.75rem 2rem;
  }
  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .table-header h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
  }
  .table-responsive {
    overflow-x: auto;
  }
  .sponsor-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .sponsor-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sponsor-table td,
  :global(.sponsor-table td) {
    padding: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
  }
  .sponsor-table tr:hover td,
  :global(.sponsor-table tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }
  .status-badge,
  :global(.status-badge) {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
  }
  .status-pending,
  :global(.status-pending) {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .status-paid,
  :global(.status-paid) {
    background: rgba(45, 212, 191, 0.15);
    color: #2dd4bf;
    border: 1px solid rgba(45, 212, 191, 0.3);
  }
  .btn-danger,
  :global(.btn-danger) {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .btn-danger:hover,
  :global(.btn-danger:hover) {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.3);
  }
  .action-btn-group,
  :global(.action-btn-group) {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  .action-locked-badge,
  :global(.action-locked-badge) {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    user-select: none;
  }

  /* Modal Dialogs */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    animation: modalFadeIn 0.2s ease forwards;
  }
  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .modal-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 2.25rem 2rem;
    max-width: 580px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    animation: modalSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes modalSlideUp {
    from { transform: translateY(12px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  .delete-card {
    max-width: 440px;
    text-align: center;
  }
  .delete-icon {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .delete-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .modal-header h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
    margin: 0.25rem 0;
  }
  .close-modal-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.15s ease;
  }
  .close-modal-btn:hover {
    color: #fff;
  }
  .modal-actions {
    margin-top: 1.75rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(0,0,0,0.2);
    border-top-color: #000;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  // @ts-nocheck
  const STORAGE_KEY = "soh_admin_password";

  // Elements
  const lockView = document.getElementById("lockView");
  const dashboardView = document.getElementById("dashboardView");
  const authActions = document.getElementById("authActions");
  const loginForm = document.getElementById("loginForm");
  const adminPasswordInput = document.getElementById("adminPassword");
  const authError = document.getElementById("authError");
  const logoutBtn = document.getElementById("logoutBtn");

  const sponsorNameInput = document.getElementById("sponsorName");
  const sponsorSlugInput = document.getElementById("sponsorSlug");
  const sponsorAmountInput = document.getElementById("sponsorAmount");
  const perksList = document.getElementById("perksList");
  const perksEmptyNote = document.getElementById("perksEmptyNote");
  const addPerkBtn = document.getElementById("addPerkBtn");
  const urlPreview = document.getElementById("urlPreview");
  const createSponsorForm = document.getElementById("createSponsorForm");
  const submitBtn = document.getElementById("submitBtn");
  const submitSpinner = document.getElementById("submitSpinner");
  const submitText = document.getElementById("submitText");
  const formError = document.getElementById("formError");

  // Edit Modal Elements
  const editModal = document.getElementById("editModal");
  const closeEditModalBtn = document.getElementById("closeEditModalBtn");
  const cancelEditBtn = document.getElementById("cancelEditBtn");
  const editSponsorForm = document.getElementById("editSponsorForm");
  const editSponsorId = document.getElementById("editSponsorId");
  const editSponsorName = document.getElementById("editSponsorName");
  const editSponsorSlug = document.getElementById("editSponsorSlug");
  const editUrlPreview = document.getElementById("editUrlPreview");
  const editSponsorAmount = document.getElementById("editSponsorAmount");
  const editAddPerkBtn = document.getElementById("editAddPerkBtn");
  const editPerksList = document.getElementById("editPerksList");
  const editPerksEmptyNote = document.getElementById("editPerksEmptyNote");
  const editFormError = document.getElementById("editFormError");
  const saveEditBtn = document.getElementById("saveEditBtn");
  const saveEditSpinner = document.getElementById("saveEditSpinner");
  const saveEditText = document.getElementById("saveEditText");

  // Delete Modal Elements
  const deleteModal = document.getElementById("deleteModal");
  const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
  const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
  const deleteModalDesc = document.getElementById("deleteModalDesc");
  const deleteModalError = document.getElementById("deleteModalError");
  const deleteSpinner = document.getElementById("deleteSpinner");
  const deleteText = document.getElementById("deleteText");

  // In-memory cache & state
  let currentSponsors = [];
  let deletingSponsorId = null;

  function updatePerksEmptyState() {
    if (!perksEmptyNote) return;
    const count = perksList.querySelectorAll(".perk-row").length;
    perksEmptyNote.style.display = count === 0 ? "block" : "none";
  }

  function addPerkRow(initialValue = "") {
    const row = document.createElement("div");
    row.className = "perk-row";
    row.innerHTML = `
      <span class="perk-prefix" aria-hidden="true">&#10003;</span>
      <input
        type="text"
        class="input-field perk-input"
        placeholder="e.g. 4 VIP Executive Passes at Dragon Gate"
        value="${escape(initialValue)}"
      />
      <button
        type="button"
        class="remove-perk-btn"
        title="Remove Entry"
        aria-label="Remove Entry"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    `;

    row.querySelector(".remove-perk-btn").addEventListener("click", () => {
      row.remove();
      updatePerksEmptyState();
    });

    perksList.appendChild(row);
    updatePerksEmptyState();

    const input = row.querySelector(".perk-input");
    if (!initialValue && input) {
      input.focus();
    }
  }

  function updateEditPerksEmptyState() {
    if (!editPerksEmptyNote) return;
    const count = editPerksList.querySelectorAll(".perk-row").length;
    editPerksEmptyNote.style.display = count === 0 ? "block" : "none";
  }

  function addEditPerkRow(initialValue = "") {
    const row = document.createElement("div");
    row.className = "perk-row";
    row.innerHTML = `
      <span class="perk-prefix" aria-hidden="true">&#10003;</span>
      <input
        type="text"
        class="input-field perk-input"
        placeholder="e.g. 4 VIP Executive Passes at Dragon Gate"
        value="${escape(initialValue)}"
      />
      <button
        type="button"
        class="remove-perk-btn"
        title="Remove Entry"
        aria-label="Remove Entry"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    `;

    row.querySelector(".remove-perk-btn").addEventListener("click", () => {
      row.remove();
      updateEditPerksEmptyState();
    });

    editPerksList.appendChild(row);
    updateEditPerksEmptyState();

    const input = row.querySelector(".perk-input");
    if (!initialValue && input) {
      input.focus();
    }
  }

  editAddPerkBtn.addEventListener("click", () => addEditPerkRow());

  function updateEditUrlPreview() {
    const slug = slugify(editSponsorSlug.value.trim() || editSponsorName.value.trim() || "sponsor-name");
    const origin = window.location.origin;
    editUrlPreview.textContent = `${origin}/thanks-${slug}`;
  }

  editSponsorName.addEventListener("input", () => {
    if (!editSponsorSlug.dataset.manual) {
      editSponsorSlug.value = slugify(editSponsorName.value);
    }
    updateEditUrlPreview();
  });

  editSponsorSlug.addEventListener("input", () => {
    editSponsorSlug.dataset.manual = "true";
    updateEditUrlPreview();
  });

  document.querySelectorAll("[data-edit-amount]").forEach((pill) => {
    pill.addEventListener("click", () => {
      editSponsorAmount.value = pill.getAttribute("data-edit-amount");
    });
  });

  function closeEditModal() {
    editModal.style.display = "none";
    editFormError.style.display = "none";
    delete editSponsorSlug.dataset.manual;
  }
  closeEditModalBtn.addEventListener("click", closeEditModal);
  cancelEditBtn.addEventListener("click", closeEditModal);

  function closeDeleteModal() {
    deleteModal.style.display = "none";
    deleteModalError.style.display = "none";
    deletingSponsorId = null;
  }
  cancelDeleteBtn.addEventListener("click", closeDeleteModal);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeEditModal();
      closeDeleteModal();
    }
  });

  editModal.addEventListener("click", (e) => {
    if (e.target === editModal) closeEditModal();
  });
  deleteModal.addEventListener("click", (e) => {
    if (e.target === deleteModal) closeDeleteModal();
  });

  function openEditModal(id) {
    const sponsor = currentSponsors.find((s) => s.id === id);
    if (!sponsor) return;

    if (sponsor.status === "paid") {
      alert("This sponsor has completed payment. No actions are permitted on paid sponsors.");
      return;
    }

    editSponsorId.value = sponsor.id;
    editSponsorName.value = sponsor.name || "";
    editSponsorSlug.value = sponsor.slug || "";
    editSponsorSlug.dataset.manual = "true";
    editSponsorAmount.value = sponsor.amount || "";
    editFormError.style.display = "none";

    updateEditUrlPreview();

    // Populate perks
    editPerksList.innerHTML = "";
    const perks = Array.isArray(sponsor.metadata?.perks)
      ? sponsor.metadata.perks
      : (sponsor.description ? sponsor.description.split("\n").map((p) => p.trim()).filter(Boolean) : []);

    perks.forEach((p) => addEditPerkRow(p));
    updateEditPerksEmptyState();

    editModal.style.display = "flex";
  }

  function openDeleteModal(id) {
    const sponsor = currentSponsors.find((s) => s.id === id);
    if (!sponsor) return;

    if (sponsor.status === "paid") {
      alert("This sponsor has completed payment. No actions are permitted on paid sponsors.");
      return;
    }

    deletingSponsorId = sponsor.id;
    deleteModalDesc.innerHTML = `Are you sure you want to delete the pending sponsor link for <strong>${escape(sponsor.name)}</strong> (¥${Number(sponsor.amount || 0).toLocaleString()})? This link will no longer be accessible.`;
    deleteModalError.style.display = "none";
    deleteModal.style.display = "flex";
  }

  // Edit sponsor form submit
  editSponsorForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    editFormError.style.display = "none";
    saveEditBtn.disabled = true;
    saveEditSpinner.style.display = "inline-block";
    saveEditText.textContent = "Saving Changes...";

    const password = getStoredPassword();
    const id = editSponsorId.value;
    const name = editSponsorName.value.trim();
    const slug = slugify(editSponsorSlug.value.trim() || name);
    const amount = Number(editSponsorAmount.value);
    const perks = Array.from(editPerksList.querySelectorAll(".perk-input"))
      .map((input) => input.value.trim())
      .filter(Boolean);

    try {
      const res = await fetch(getApiUrl("/api/admin/sponsors"), {
        method: "PUT",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${password}`,
        },
        body: JSON.stringify({
          id,
          name,
          slug,
          amount,
          perks,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Failed to update sponsor link");
      }

      closeEditModal();
      loadSponsors();
    } catch (err) {
      editFormError.textContent = err.message || "An error occurred";
      editFormError.style.display = "block";
    } finally {
      saveEditBtn.disabled = false;
      saveEditSpinner.style.display = "none";
      saveEditText.textContent = "Save Changes →";
    }
  });

  // Confirm delete sponsor
  confirmDeleteBtn.addEventListener("click", async () => {
    if (!deletingSponsorId) return;

    confirmDeleteBtn.disabled = true;
    deleteSpinner.style.display = "inline-block";
    deleteText.textContent = "Deleting...";

    const password = getStoredPassword();

    try {
      const res = await fetch(getApiUrl(`/api/admin/sponsors?id=${encodeURIComponent(deletingSponsorId)}`), {
        method: "DELETE",
        headers: {
          Authorization: `Bearer ${password}`,
        },
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Failed to delete sponsor link");
      }

      closeDeleteModal();
      loadSponsors();
    } catch (err) {
      deleteModalError.textContent = err.message || "Failed to delete sponsor";
      deleteModalError.style.display = "block";
    } finally {
      confirmDeleteBtn.disabled = false;
      deleteSpinner.style.display = "none";
      deleteText.textContent = "Delete Sponsor";
    }
  });

  const createdAlert = document.getElementById("createdAlert");
  const createdUrlInput = document.getElementById("createdUrlInput");
  const copyUrlBtn = document.getElementById("copyUrlBtn");
  const testUrlLink = document.getElementById("testUrlLink");

  const refreshBtn = document.getElementById("refreshBtn");
  const sponsorsTbody = document.getElementById("sponsorsTbody");

  // Slug generator helper
  function slugify(text) {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9_-]/g, "-")
      .replace(/-+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function updateUrlPreview() {
    const slug = slugify(sponsorSlugInput.value.trim() || sponsorNameInput.value.trim() || "sponsor-name");
    const origin = window.location.origin;
    urlPreview.textContent = `${origin}/thanks-${slug}`;
  }

  sponsorNameInput.addEventListener("input", () => {
    if (!sponsorSlugInput.dataset.manual) {
      sponsorSlugInput.value = slugify(sponsorNameInput.value);
    }
    updateUrlPreview();
  });

  sponsorSlugInput.addEventListener("input", () => {
    sponsorSlugInput.dataset.manual = "true";
    updateUrlPreview();
  });

  // Preset pills
  document.querySelectorAll(".preset-pills .pill").forEach((pill) => {
    pill.addEventListener("click", () => {
      sponsorAmountInput.value = pill.getAttribute("data-amount");
    });
  });

  // Auth flow
  function getStoredPassword() {
    return sessionStorage.getItem(STORAGE_KEY) || "";
  }

  function showDashboard() {
    lockView.style.display = "none";
    dashboardView.style.display = "block";
    authActions.style.display = "block";
    updateUrlPreview();
    loadSponsors();
  }

  function showLock() {
    lockView.style.display = "flex";
    dashboardView.style.display = "none";
    authActions.style.display = "none";
    sessionStorage.removeItem(STORAGE_KEY);
    adminPasswordInput.value = "";
  }

  function getApiUrl(path) {
    if (window.location.hostname === "localhost" && window.location.port !== "8787") {
      return `http://localhost:8787${path}`;
    }
    return path;
  }

  logoutBtn.addEventListener("click", showLock);

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    authError.style.display = "none";
    const password = adminPasswordInput.value.trim();

    try {
      const res = await fetch(getApiUrl("/api/admin/verify"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Authentication failed");
      }

      sessionStorage.setItem(STORAGE_KEY, password);
      showDashboard();
    } catch (err) {
      let msg = err.message || "Invalid password";
      if (err.name === "TypeError" && window.location.hostname === "localhost" && window.location.port === "4321") {
        msg = "Cannot connect to Cloudflare Functions on port 8787. Please run 'npm run dev:functions' in your terminal.";
      }
      authError.textContent = msg;
      authError.style.display = "block";
    }
  });

  // Load sponsors table
  async function loadSponsors() {
    const password = getStoredPassword();
    if (!password) return showLock();

    sponsorsTbody.innerHTML = `
      <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-muted);">Loading sponsors...</td></tr>
    `;

    try {
      const res = await fetch(getApiUrl("/api/admin/sponsors"), {
        headers: { Authorization: `Bearer ${password}` },
      });

      if (res.status === 401) {
        return showLock();
      }

      const data = await res.json();
      const sponsors = data.sponsors || [];
      currentSponsors = sponsors;

      if (sponsors.length === 0) {
        sponsorsTbody.innerHTML = `
          <tr><td colspan="6" style="text-align:center;padding:2rem;color:rgba(255,255,255,0.4);">No sponsor links created yet. Use the form above to generate one!</td></tr>
        `;
        return;
      }

      const origin = window.location.origin;
      sponsorsTbody.innerHTML = sponsors.map((s) => {
        const url = s.url || `${origin}/thanks-${s.slug}`;
        const isPaid = s.status === "paid";
        const statusClass = isPaid ? "status-paid" : "status-pending";
        const formattedAmount = "¥" + Number(s.amount || 0).toLocaleString();
        const dateStr = s.created_at ? new Date(s.created_at).toLocaleDateString() : "-";

        let actionsHtml = "";
        if (isPaid) {
          actionsHtml = `
            <span class="action-locked-badge" title="Payment completed. No actions are permitted on paid sponsors.">
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" style="display:inline-block;vertical-align:middle;margin-right:4px;">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              No actions
            </span>
          `;
        } else {
          actionsHtml = `
            <div class="action-btn-group">
              <button class="btn btn-sm btn-secondary copy-link-btn" data-url="${escape(url)}" title="Copy Link">Copy</button>
              <button class="btn btn-sm btn-secondary edit-sponsor-btn" data-id="${escape(s.id)}" title="Edit Pending Sponsor">Edit</button>
              <button class="btn btn-sm btn-danger delete-sponsor-btn" data-id="${escape(s.id)}" title="Delete Pending Sponsor">Delete</button>
              <a href="${escape(url)}" target="_blank" class="btn btn-sm btn-ghost" title="Open Sponsor Page">&nearr;</a>
            </div>
          `;
        }

        return `
          <tr>
            <td><strong style="color:#fff;">${escape(s.name)}</strong></td>
            <td><a href="${escape(url)}" target="_blank" style="color:#2dd4bf;text-decoration:none;font-family:monospace;font-size:0.85rem;">/thanks-${escape(s.slug)}</a></td>
            <td><strong style="color:#fff;">${formattedAmount}</strong></td>
            <td><span class="status-badge ${statusClass}">${isPaid ? "Paid ✓" : "Pending"}</span></td>
            <td style="color:rgba(255,255,255,0.5);font-size:0.85rem;">${dateStr}</td>
            <td style="text-align:right;">${actionsHtml}</td>
          </tr>
        `;
      }).join("");

      // Bind buttons in table
      document.querySelectorAll(".copy-link-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = btn.getAttribute("data-url");
          navigator.clipboard.writeText(url).then(() => {
            const originalText = btn.textContent;
            btn.textContent = "Copied!";
            setTimeout(() => { btn.textContent = originalText; }, 2000);
          });
        });
      });

      document.querySelectorAll(".edit-sponsor-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          openEditModal(btn.getAttribute("data-id"));
        });
      });

      document.querySelectorAll(".delete-sponsor-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          openDeleteModal(btn.getAttribute("data-id"));
        });
      });
    } catch (err) {
      sponsorsTbody.innerHTML = `
        <tr><td colspan="6" style="text-align:center;padding:2rem;color:#f87171;">Failed to load sponsors: ${escape(err.message)}</td></tr>
      `;
    }
  }

  refreshBtn.addEventListener("click", loadSponsors);

  // Create sponsor link submission
  createSponsorForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError.style.display = "none";
    createdAlert.style.display = "none";

    const password = getStoredPassword();
    if (!password) return showLock();

    submitBtn.disabled = true;
    submitSpinner.style.display = "inline-block";
    submitText.textContent = "Creating sponsor link...";

    const name = sponsorNameInput.value.trim();
    const slug = slugify(sponsorSlugInput.value.trim() || name);
    const amount = Number(sponsorAmountInput.value);
    const perks = Array.from(perksList.querySelectorAll(".perk-input"))
      .map((el) => el.value.trim())
      .filter(Boolean);

    try {
      const res = await fetch(getApiUrl("/api/admin/sponsors"), {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${password}`,
        },
        body: JSON.stringify({
          name,
          slug,
          amount,
          perks,
        }),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || "Failed to create sponsor link");
      }

      // Show success alert
      createdUrlInput.value = data.url;
      testUrlLink.href = data.url;
      createdAlert.style.display = "block";
      createdAlert.scrollIntoView({ behavior: "smooth" });

      // Reset form
      createSponsorForm.reset();
      perksList.innerHTML = "";
      updatePerksEmptyState();
      delete sponsorSlugInput.dataset.manual;
      updateUrlPreview();

      // Reload table
      loadSponsors();
    } catch (err) {
      formError.textContent = err.message || "An error occurred";
      formError.style.display = "block";
    } finally {
      submitBtn.disabled = false;
      submitSpinner.style.display = "none";
      submitText.textContent = "Generate Custom Sponsor Link →";
    }
  });

  // Copy created URL
  copyUrlBtn.addEventListener("click", () => {
    createdUrlInput.select();
    navigator.clipboard.writeText(createdUrlInput.value).then(() => {
      copyUrlBtn.textContent = "Copied!";
      setTimeout(() => { copyUrlBtn.textContent = "Copy Link"; }, 2000);
    });
  });

  function escape(str) {
    return String(str || "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    })[c]);
  }

  // Initial auto-login check
  if (getStoredPassword()) {
    showDashboard();
  }
</script>
