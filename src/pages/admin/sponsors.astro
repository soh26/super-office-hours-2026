---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Sponsor Link Management — Super Office Hours">
  <div class="admin-wrapper">
    <!-- Top Navigation Header -->
    <header class="admin-header">
      <div class="header-inner">
        <a href="/" class="header-brand" aria-label="Takeoff Tokyo home">
          <img src="/images/takeoff-tokyo-logo.png" alt="Takeoff Tokyo" height="26" style="height:26px;width:auto;" />
          <span class="badge-admin">Admin</span>
        </a>
        <div id="authActions" class="hidden">
          <button type="button" id="logoutBtn" class="btn btn-ghost btn-sm">Lock Dashboard</button>
        </div>
      </div>
    </header>

    <!-- 1. Password Lock View -->
    <div id="lockView" class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-icon">🔒</div>
        <h2>Organizer Access</h2>
        <p class="auth-desc">Enter the sponsor administration password to manage custom sponsor checkout links.</p>

        <form id="loginForm">
          <div class="form-group">
            <label for="adminPassword">Password</label>
            <input
              type="password"
              id="adminPassword"
              class="input-field"
              placeholder="Enter admin password"
              autocomplete="current-password"
              required
            />
          </div>
          <div id="authError" class="alert-error hidden"></div>
          <button type="submit" id="unlockBtn" class="btn btn-primary btn-block" style="margin-top:1.25rem;">
            Unlock Dashboard &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- 2. Main Admin Dashboard -->
    <main id="dashboardView" class="dashboard-wrapper hidden">
      <div class="dashboard-header">
        <h1>Custom Sponsor Checkouts</h1>
        <p class="text-muted">Create tailored Stripe checkout links.</p>
      </div>

      <!-- Create Sponsor Card -->
      <section class="card form-card">
        <div class="card-head">
          <h2>New Sponsor Link</h2>
        </div>

        <form id="createSponsorForm">
          <div class="form-grid">
            <div class="form-group">
              <label for="sponsorName">Sponsor Name <span class="req">*</span></label>
              <input type="text" id="sponsorName" class="input-field" placeholder="e.g. Acme Innovations Inc." required />
            </div>
            <div class="form-group">
              <label for="sponsorSlug">Custom URL Slug <span class="req">*</span></label>
              <input type="text" id="sponsorSlug" class="input-field" placeholder="e.g. acme-innovations" required />
            </div>
          </div>

          <div class="url-preview-banner">
            <span class="url-preview-label">Live Link:</span>
            <code id="urlPreview">https://soh.takeoff-tokyo.com/thanks-acme-innovations</code>
          </div>

          <div class="form-grid" style="margin-top:1.25rem;">
            <div class="form-group">
              <label for="sponsorCurrency">Currency <span class="req">*</span></label>
              <select id="sponsorCurrency" class="input-field select-field">
                <option value="jpy" selected>JPY (&#165;)</option>
                <option value="usd">USD (&#36;)</option>
                <option value="eur">EUR (&#8364;)</option>
              </select>
            </div>
            <div class="form-group">
              <label for="sponsorAmount">Amount <span class="req">*</span></label>
              <div class="input-prefix-wrapper">
                <span class="input-prefix" id="sponsorCurrencyPrefix">¥</span>
                <input type="number" id="sponsorAmount" class="input-field with-prefix" placeholder="300000" min="1" step="any" required />
              </div>
            </div>
          </div>

          <!-- Explicit Perks List -->
          <div class="form-group" style="margin-top:1.5rem;">
            <label style="margin-bottom:0.25rem;">Package Description</label>
            <span class="field-hint" style="margin-top:0;margin-bottom:0.75rem;">
              Press Enter to add the next entry.
            </span>
            <div id="createPerksList" class="perks-list"></div>
          </div>

          <div id="createFormError" class="alert-error hidden" style="margin-top:1rem;"></div>

          <div class="form-actions">
            <button type="submit" id="createSubmitBtn" class="btn btn-accent">
              <span class="spinner hidden" id="createSpinner"></span>
              <span id="createText">Generate Custom Sponsor Link &rarr;</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Success Notification Box -->
      <section id="createdBanner" class="card success-banner hidden" style="margin-top:1.5rem;">
        <div class="success-banner-inner">
          <div class="success-icon">&#10003;</div>
          <div class="success-content">
            <h3>Custom Sponsor Link Created!</h3>
            <p>Send this link directly to the sponsor representative:</p>
            <div class="copy-url-row">
              <input type="text" id="createdUrlInput" class="input-field copy-field" readonly />
              <button type="button" id="copyCreatedUrlBtn" class="btn btn-secondary">Copy Link</button>
              <a id="testCreatedUrlLink" href="#" target="_blank" class="btn btn-ghost">Open Page &nearr;</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Existing Sponsors Table -->
      <section class="card table-card" style="margin-top:2.5rem;">
        <div class="table-header">
          <div>
            <h2>Track Existing Sponsor Links</h2>
          </div>
          <button type="button" id="refreshBtn" class="btn btn-ghost btn-sm">Refresh List</button>
        </div>

        <div class="table-responsive">
          <table class="sponsor-table">
            <thead>
              <tr>
                <th>Sponsor Name</th>
                <th>Custom URL</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Views</th>
                <th>Created</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody id="sponsorsTbody">
              <tr>
                <td colspan="7" class="table-empty-cell">Loading sponsors...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- Native HTML5 Dialog: Edit Pending Sponsor -->
    <dialog id="editDialog" class="admin-dialog">
      <div class="dialog-box">
        <div class="dialog-header">
          <div>
            <h2>Update Sponsor Link</h2>
          </div>
          <button type="button" class="btn-close-dialog" data-action="close-dialog" data-dialog="editDialog" aria-label="Close dialog">&times;</button>
        </div>

        <form id="editSponsorForm">
          <input type="hidden" id="editSponsorId" />

          <div class="form-grid">
            <div class="form-group">
              <label for="editSponsorName">Sponsor Name <span class="req">*</span></label>
              <input type="text" id="editSponsorName" class="input-field" required />
            </div>
            <div class="form-group">
              <label for="editSponsorSlug">Custom URL Slug <span class="req">*</span></label>
              <input type="text" id="editSponsorSlug" class="input-field" required />
            </div>
          </div>

          <div class="url-preview-banner">
            <span class="url-preview-label">Live Link:</span>
            <code id="editUrlPreview">https://soh.takeoff-tokyo.com/thanks-...</code>
          </div>

          <div class="form-grid" style="margin-top:1.25rem;">
            <div class="form-group">
              <label for="editSponsorCurrency">Currency <span class="req">*</span></label>
              <select id="editSponsorCurrency" class="input-field select-field">
                <option value="jpy">JPY (¥) — Japanese Yen</option>
                <option value="usd">USD ($) — US Dollar</option>
                <option value="eur">EUR (€) — Euro</option>
              </select>
            </div>
            <div class="form-group">
              <label for="editSponsorAmount">Amount <span class="req">*</span></label>
              <div class="input-prefix-wrapper">
                <span class="input-prefix" id="editSponsorCurrencyPrefix">¥</span>
                <input type="number" id="editSponsorAmount" class="input-field with-prefix" min="1" step="any" required />
              </div>
            </div>
          </div>

          <div class="form-group" style="margin-top:1.5rem;">
            <label style="margin-bottom:0.25rem;">Package Description</label>
            <span class="field-hint" style="margin-top:0;margin-bottom:0.75rem;">
              Press Enter to add the next entry.
            </span>
            <div id="editPerksList" class="perks-list"></div>
          </div>

          <div id="editFormError" class="alert-error hidden" style="margin-top:1rem;"></div>

          <div class="dialog-actions">
            <button type="button" class="btn btn-ghost" data-action="close-dialog" data-dialog="editDialog">Cancel</button>
            <button type="submit" id="saveEditBtn" class="btn btn-accent">
              <span class="spinner hidden" id="editSpinner"></span>
              <span id="editText">Save Changes &rarr;</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Native HTML5 Dialog: Delete Pending Sponsor Confirmation -->
    <dialog id="deleteDialog" class="admin-dialog">
      <div class="dialog-box delete-box">
        <div class="delete-icon">⚠️</div>
        <h3>Delete Sponsor Link</h3>
        <p id="deleteDialogDesc" class="delete-desc">
          Are you sure you want to delete this pending sponsor link?
        </p>
        <div id="deleteDialogError" class="alert-error hidden" style="margin-bottom:1rem;"></div>
        <div class="dialog-actions" style="justify-content:center;">
          <button type="button" class="btn btn-ghost" data-action="close-dialog" data-dialog="deleteDialog">Cancel</button>
          <button type="button" id="confirmDeleteBtn" class="btn btn-danger">
            <span class="spinner hidden" id="deleteSpinner"></span>
            <span id="deleteBtnText">Delete Sponsor</span>
          </button>
        </div>
      </div>
    </dialog>

    <!-- Native HTML5 Dialog: Access Logs (Views & Geolocation) -->
    <dialog id="viewsDialog" class="admin-dialog">
      <div class="dialog-box logs-box">
        <div class="dialog-header">
          <div>
            <h2 id="viewsDialogTitle">Access Logs</h2>
            <p id="viewsDialogSubtitle" class="dialog-subtitle">Live link view history</p>
          </div>
          <button type="button" class="btn-close-dialog" data-action="close-dialog" data-dialog="viewsDialog" aria-label="Close dialog">&times;</button>
        </div>

        <div class="logs-summary-bar">
          <div class="logs-stat">
            <span class="logs-stat-label">Total Views</span>
            <strong id="viewsTotalCount" class="logs-stat-val">0</strong>
          </div>
          <div class="logs-stat">
            <span class="logs-stat-label">Unique Cities</span>
            <strong id="viewsUniqueCities" class="logs-stat-val">0</strong>
          </div>
          <div class="logs-stat">
            <span class="logs-stat-label">Latest Access</span>
            <strong id="viewsLastAccessed" class="logs-stat-val">-</strong>
          </div>
        </div>

        <div class="logs-table-wrapper">
          <table class="logs-table">
            <thead>
              <tr>
                <th>Timestamp</th>
                <th>City / Location</th>
              </tr>
            </thead>
            <tbody id="viewsTbody">
              <tr>
                <td colspan="2" class="table-empty-cell">Loading view logs...</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="dialog-actions" style="justify-content:space-between;align-items:center;">
          <button type="button" id="refreshViewsBtn" class="btn btn-ghost btn-sm">Refresh Logs</button>
          <button type="button" class="btn btn-secondary" data-action="close-dialog" data-dialog="viewsDialog">Close</button>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<style>
  /* Layout & Theme */
  .admin-wrapper {
    min-height: 100vh;
    background: #09090b;
    color: #f3f4f6;
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
  .admin-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-brand {
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .badge-admin {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c084fc;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Password Lock View */
  .auth-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
  }
  .auth-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }
  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .auth-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .auth-desc {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  /* Main Dashboard Container */
  .dashboard-wrapper {
    max-width: 1100px;
    margin: 2.5rem auto;
    padding: 0 1.5rem;
    width: 100%;
    box-sizing: border-box;
    flex: 1;
  }
  .dashboard-header {
    margin-bottom: 2rem;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
  }
  .dashboard-header h1 {
    font-family: "TT Lakes Neue Expanded", "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 0.35rem 0;
  }
  .text-muted {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    margin: 0;
  }

  /* Cards */
  .card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }
  .form-card {
    padding: 2rem;
  }
  .card-head {
    margin-bottom: 1.75rem;
  }
  .card-step {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #2dd4bf;
    background: rgba(45, 212, 191, 0.1);
    border: 1px solid rgba(45, 212, 191, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }
  .card-head h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #fff;
    margin: 0.35rem 0 0.25rem 0;
  }
  .card-subtitle {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.88rem;
    margin: 0;
  }

  /* Form Elements */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form-group {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.45rem;
  }
  .req {
    color: #f87171;
  }
  .field-hint {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 0.35rem;
    margin-bottom: 0.75rem;
  }
  .input-field {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #fff;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  .input-field:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
    background: rgba(255, 255, 255, 0.07);
  }
  select.input-field {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='rgba(255,255,255,0.6)' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.1em;
    padding-right: 2.5rem;
    cursor: pointer;
  }
  select.input-field option {
    background: #18181b;
    color: #fff;
  }
  .input-prefix-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-prefix {
    position: absolute;
    left: 1rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
  }
  .input-field.with-prefix {
    padding-left: 2rem;
  }
  .preset-pills {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.45rem;
  }
  .pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }
  .pill:hover {
    background: rgba(45, 212, 191, 0.15);
    border-color: rgba(45, 212, 191, 0.4);
    color: #2dd4bf;
  }

  /* Live Preview Box */
  .url-preview-banner {
    margin-top: 1rem;
    background: rgba(45, 212, 191, 0.04);
    border: 1px solid rgba(45, 212, 191, 0.18);
    border-radius: 8px;
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .url-preview-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
  }
  .url-preview-banner code {
    font-family: monospace;
    font-size: 0.88rem;
    color: #2dd4bf;
    word-break: break-all;
  }

  /* Explicit Perks Section */
  .section-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }
  .btn-add-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(45, 212, 191, 0.1);
    border: 1px solid rgba(45, 212, 191, 0.35);
    color: #2dd4bf;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }
  .btn-add-entry:hover {
    background: rgba(45, 212, 191, 0.22);
    border-color: #2dd4bf;
    transform: translateY(-1px);
    box-shadow: 0 2px 10px rgba(45, 212, 191, 0.25);
  }
  .perks-empty-note {
    padding: 0.85rem 1.15rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    text-align: center;
    line-height: 1.5;
  }
  .perks-empty-note strong {
    color: #2dd4bf;
  }
  .perks-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  /* Dynamically Added Perk Row */
  :global(.perk-row) {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }
  :global(.perk-prefix) {
    color: #2dd4bf;
    font-size: 0.95rem;
    font-weight: 800;
    flex-shrink: 0;
  }
  :global(.perk-input) {
    flex: 1;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 0.65rem 0.95rem;
    color: #fff;
    font-size: 0.92rem;
    font-family: inherit;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  :global(.perk-input:focus) {
    outline: none;
    border-color: #2dd4bf;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.2);
  }
  :global(.remove-perk-btn) {
    background: transparent;
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #f87171;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.25rem;
    line-height: 1;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }
  :global(.remove-perk-btn:hover) {
    background: rgba(239, 68, 68, 0.15);
    border-color: #ef4444;
    color: #ef4444;
  }

  /* Buttons */
  .form-actions {
    margin-top: 1.75rem;
    display: flex;
    justify-content: flex-end;
  }
  .btn,
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.35rem;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    text-decoration: none;
    box-sizing: border-box;
  }
  .btn-primary,
  :global(.btn-primary) {
    background: #2dd4bf;
    color: #0a0a0c;
  }
  .btn-primary:hover,
  :global(.btn-primary:hover) {
    background: #38e6d0;
  }
  .btn-accent,
  :global(.btn-accent) {
    background: linear-gradient(135deg, #2dd4bf, #06b6d4);
    color: #0a0a0c;
