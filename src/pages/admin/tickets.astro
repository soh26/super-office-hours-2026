---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Ticket Registrations — Super Office Hours Admin">
  <div class="admin-wrapper">
    <!-- Top Navigation Header -->
    <header class="admin-header">
      <div class="header-inner">
        <div class="header-left">
          <a href="/" class="header-brand" aria-label="Takeoff Tokyo home">
            <img src="/images/takeoff-tokyo-logo.png" alt="Takeoff Tokyo" height="26" style="height:26px;width:auto;" />
            <span class="badge-admin">Admin</span>
          </a>
          <nav class="admin-nav" aria-label="Admin Navigation">
            <a href="/admin/tickets" class="admin-nav-link active">Tickets</a>
            <a href="/admin/sponsors" class="admin-nav-link">Sponsors</a>
          </nav>
        </div>
        <div id="authActions" class="hidden">
          <button type="button" id="logoutBtn" class="btn btn-ghost btn-sm">Lock Dashboard</button>
        </div>
      </div>
    </header>

    <!-- 1. Password Lock View -->
    <div id="lockView" class="auth-wrapper">
      <div class="auth-card">
        <div class="auth-icon">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:rgba(255,255,255,0.7);"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h2>Organizer Access</h2>
        <p class="auth-desc">Enter the admin password to view and filter registered attendee tickets.</p>

        <form id="loginForm">
          <div class="form-group">
            <label for="adminPassword">Password</label>
            <input
              type="password"
              id="adminPassword"
              class="input-field"
              placeholder="Enter admin password"
              autocomplete="current-password"
              required
            />
          </div>
          <div id="authError" class="alert-error hidden"></div>
          <button type="submit" id="unlockBtn" class="btn btn-primary btn-block" style="margin-top:1.25rem;">
            Unlock Dashboard &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- 2. Main Admin Dashboard -->
    <main id="dashboardView" class="dashboard-wrapper hidden">
      <!-- Minimal Header -->
      <div class="dashboard-header-row">
        <div>
          <h1>Ticket Registrations</h1>
          <p class="text-muted">Live registrations from database</p>
        </div>
        <div class="header-controls">
          <button type="button" id="exportCsvBtn" class="btn btn-ghost btn-sm" title="Export current list to CSV">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export CSV
          </button>
          <button type="button" id="refreshBtn" class="btn btn-ghost btn-sm">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Quick Metrics Ribbon -->
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="metric-label">Total Registrations</span>
          <span class="metric-val" id="metricTotal">0</span>
        </div>
        <div class="metric-card metric-paid">
          <span class="metric-label">Paid Tickets</span>
          <span class="metric-val" id="metricPaid">0</span>
        </div>
        <div class="metric-card metric-pending">
          <span class="metric-label">Pending Payment</span>
          <span class="metric-val" id="metricPending">0</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Paid Revenue</span>
          <span class="metric-val" id="metricRevenue">¥0</span>
        </div>
      </div>

      <!-- Filters and Search Bar -->
      <div class="toolbar">
        <div class="filters-row">
          <!-- Status Filter -->
          <div class="filter-group">
            <span class="filter-group-label">Status</span>
            <div class="filter-tabs" role="tablist" aria-label="Filter payment status">
              <button type="button" class="filter-tab active" data-status="all" id="tabStatusAll">
                All <span class="tab-count" id="countStatusAll">0</span>
              </button>
              <button type="button" class="filter-tab" data-status="paid" id="tabStatusPaid">
                Paid <span class="tab-count" id="countStatusPaid">0</span>
              </button>
              <button type="button" class="filter-tab" data-status="pending" id="tabStatusPending">
                Pending <span class="tab-count" id="countStatusPending">0</span>
              </button>
            </div>
          </div>

          <!-- Ticket Type Filter -->
          <div class="filter-group">
            <span class="filter-group-label">Type</span>
            <div class="filter-tabs" role="tablist" aria-label="Filter ticket type">
              <button type="button" class="filter-tab active" data-type="all" id="tabTypeAll">
                All Types <span class="tab-count" id="countTypeAll">0</span>
              </button>
              <button type="button" class="filter-tab" data-type="startup" id="tabTypeStartup">
                Startup <span class="tab-count" id="countTypeStartup">0</span>
              </button>
              <button type="button" class="filter-tab" data-type="investor" id="tabTypeInvestor">
                Investor <span class="tab-count" id="countTypeInvestor">0</span>
              </button>
              <button type="button" class="filter-tab" data-type="student" id="tabTypeStudent">
                Student <span class="tab-count" id="countTypeStudent">0</span>
              </button>
            </div>
          </div>
        </div>

        <div class="search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Search name, email, company, ticket..."
            aria-label="Search registrations"
          />
          <button type="button" id="clearSearchBtn" class="clear-search-btn hidden" aria-label="Clear search">&times;</button>
        </div>
      </div>

      <!-- Registrations Table -->
      <div class="card table-card">
        <div class="table-responsive">
          <table class="tickets-table">
            <thead>
              <tr>
                <th style="width:110px;">Status</th>
                <th>Attendee</th>
                <th>Company &amp; Role</th>
                <th>Tickets</th>
                <th style="text-align:right;">Amount</th>
                <th style="width:140px;">Registered</th>
                <th style="width:70px;text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody id="ticketsTbody">
              <tr>
                <td colspan="7" class="table-empty-cell">Loading registrations...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- Attendee Details Dialog -->
    <dialog id="detailsDialog" class="admin-dialog">
      <div class="dialog-box">
        <div class="dialog-header">
          <div>
            <h2 id="detailName">Attendee Details</h2>
            <p id="detailEmail" class="dialog-subtitle"></p>
          </div>
          <button type="button" class="btn-close-dialog" data-action="close-dialog" aria-label="Close dialog">&times;</button>
        </div>

        <div class="detail-grid">
          <div class="detail-item">
            <span class="detail-label">Payment Status</span>
            <div id="detailStatus"></div>
          </div>
          <div class="detail-item">
            <span class="detail-label">Total Amount</span>
            <span id="detailAmount" class="detail-value font-mono"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Company</span>
            <span id="detailCompany" class="detail-value"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Role</span>
            <span id="detailRole" class="detail-value"></span>
          </div>
          <div class="detail-item full-width">
            <span class="detail-label">Tickets Purchased</span>
            <div id="detailTickets" class="detail-tickets-box"></div>
          </div>
          <div class="detail-item full-width" id="questionnaireSection">
            <div class="section-label-row">
              <span class="detail-label">Questionnaire Responses</span>
              <span id="detailQCount" class="q-badge-count"></span>
            </div>
            <div id="detailQuestionnaire" class="detail-questionnaire-wrap"></div>
            <div class="q-raw-toggle-wrap">
              <button type="button" id="toggleRawJsonBtn" class="btn btn-ghost btn-sm" style="font-size:0.75rem;padding:0.25rem 0.65rem;">
                <span id="rawJsonBtnText">Show Raw JSON</span>
              </button>
              <pre id="qRawJsonBox" class="detail-code-box hidden" style="margin-top:0.6rem;"></pre>
            </div>
          </div>
          <div class="detail-item">
            <span class="detail-label">Registration ID</span>
            <code id="detailRegId" class="detail-code"></code>
          </div>
          <div class="detail-item">
            <span class="detail-label">Stripe Session ID</span>
            <code id="detailStripeSession" class="detail-code"></code>
          </div>
          <div class="detail-item">
            <span class="detail-label">Created At</span>
            <span id="detailCreatedAt" class="detail-value"></span>
          </div>
          <div class="detail-item">
            <span class="detail-label">Updated At</span>
            <span id="detailUpdatedAt" class="detail-value"></span>
          </div>
        </div>

        <div class="dialog-actions" style="justify-content:flex-end;margin-top:1.5rem;">
          <button type="button" class="btn btn-secondary" data-action="close-dialog">Close</button>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<style>
  /* Layout & Theme */
  .admin-wrapper {
    min-height: 100vh;
    background: #09090b;
    color: #f3f4f6;
    display: flex;
    flex-direction: column;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
  .admin-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(9, 9, 11, 0.85);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    max-width: 1150px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-left {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .header-brand {
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .badge-admin {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.4);
    color: #c084fc;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Admin Header Nav */
  .admin-nav {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.2rem;
    gap: 0.2rem;
  }
  .admin-nav-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    transition: all 0.15s ease;
  }
  .admin-nav-link:hover {
    color: #fff;
  }
  .admin-nav-link.active {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-weight: 700;
  }

  /* Password Lock View */
  .auth-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
  }
  .auth-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    max-width: 440px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
  }
  .auth-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .auth-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .auth-desc {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  /* Main Dashboard Container */
  .dashboard-wrapper {
    max-width: 1150px;
    margin: 2rem auto 4rem;
    padding: 0 1.5rem;
    width: 100%;
    box-sizing: border-box;
    flex: 1;
  }
  .dashboard-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .dashboard-header-row h1 {
    font-family: "TT Lakes Neue Expanded", "Barlow Condensed", sans-serif;
    font-weight: 900;
    font-stretch: 125%;
    font-size: clamp(1.6rem, 3.5vw, 2.1rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 0.25rem 0;
  }
  .text-muted {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9rem;
    margin: 0;
  }
  .header-controls {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  /* Metrics Ribbon */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .metric-card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .metric-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.45);
  }
  .metric-val {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    font-family: "TT Lakes Neue Expanded", "Barlow Condensed", monospace, sans-serif;
    font-stretch: 115%;
  }
  .metric-paid .metric-val {
    color: #2dd4bf;
  }
  .metric-pending .metric-val {
    color: #fbbf24;
  }

  /* Toolbar: Tabs & Search */
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .filters-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .filter-group-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.4);
  }
  .filter-tabs {
    display: inline-flex;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.3rem;
    gap: 0.3rem;
  }
  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }
  .filter-tab:hover {
    color: #fff;
  }
  .filter-tab.active {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .tab-count {
    font-size: 0.72rem;
    padding: 0.1rem 0.45rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    font-weight: 700;
  }
  .filter-tab.active .tab-count {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 380px;
    min-width: 240px;
  }
  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.6rem 2.2rem 0.6rem 2.4rem;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: #fff;
    font-size: 0.88rem;
    font-family: inherit;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }
  .search-input:focus {
    outline: none;
    border-color: #2dd4bf;
    background: #18181f;
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.2);
  }
  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }
  .clear-search-btn {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0.2rem;
  }
  .clear-search-btn:hover {
    color: #fff;
  }

  /* Table Card */
  .card {
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }
  .table-card {
    padding: 0;
  }
  .table-responsive {
    overflow-x: auto;
  }
  .tickets-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }
  .tickets-table th {
    padding: 0.85rem 1rem;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
  }
  :global(.tickets-table td) {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    vertical-align: middle;
  }
  :global(.tickets-table tr:hover td) {
    background: rgba(255, 255, 255, 0.025);
  }
  .table-empty-cell,
  :global(.table-empty-cell) {
    text-align: center;
    padding: 3rem 1rem;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.92rem;
  }

  /* Badges & Cells */
  :global(.status-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  :global(.status-paid) {
    background: rgba(45, 212, 191, 0.14);
    color: #2dd4bf;
    border: 1px solid rgba(45, 212, 191, 0.3);
  }
  :global(.status-pending) {
    background: rgba(245, 158, 11, 0.14);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  :global(.status-failed),
  :global(.status-canceled) {
    background: rgba(239, 68, 68, 0.14);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  :global(.attendee-name) {
    font-weight: 700;
    color: #fff;
    display: block;
    margin-bottom: 0.15rem;
  }
  :global(.attendee-email) {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }
  :global(.attendee-email:hover) {
    color: #2dd4bf;
    text-decoration: underline;
  }
  :global(.company-name) {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    display: block;
  }
  :global(.role-name) {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
  }
  :global(.tickets-summary) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  :global(.ticket-tag) {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 6px;
    padding: 0.15rem 0.5rem;
    font-size: 0.76rem;
    font-weight: 600;
  }
  :global(.ticket-tag-strong) {
    color: #2dd4bf;
  }
  :global(.amount-cell) {
    text-align: right;
    font-weight: 700;
    color: #fff;
    font-family: monospace, sans-serif;
  }
  :global(.date-cell) {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }
  :global(.date-relative) {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.4);
    display: block;
  }

  /* Form & Inputs */
  .form-group {
    text-align: left;
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.4rem;
  }
  .input-field {
    width: 100%;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    color: #fff;
    font-size: 0.95rem;
    font-family: inherit;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }
  .input-field:focus {
    outline: none;
    border-color: #2dd4bf;
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.25);
  }

  /* Buttons */
  .btn,
  :global(.btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 1.15rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 600;
    font-family: inherit;
