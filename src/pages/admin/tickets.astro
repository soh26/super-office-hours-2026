<script>
  // @ts-nocheck
  (function () {
    const STORAGE_KEY = "soh_admin_password";

    // DOM Elements
    const lockView = document.getElementById("lockView");
    const dashboardView = document.getElementById("dashboardView");
    const authActions = document.getElementById("authActions");
    const loginForm = document.getElementById("loginForm");
    const adminPasswordInput = document.getElementById("adminPassword");
    const authError = document.getElementById("authError");
    const logoutBtn = document.getElementById("logoutBtn");
    const refreshBtn = document.getElementById("refreshBtn");
    const exportCsvBtn = document.getElementById("exportCsvBtn");

    const metricTotal = document.getElementById("metricTotal");
    const metricPaid = document.getElementById("metricPaid");
    const metricPending = document.getElementById("metricPending");
    const metricRevenue = document.getElementById("metricRevenue");

    const tabStatusAll = document.getElementById("tabStatusAll");
    const tabStatusPaid = document.getElementById("tabStatusPaid");
    const tabStatusPending = document.getElementById("tabStatusPending");
    const countStatusAll = document.getElementById("countStatusAll");
    const countStatusPaid = document.getElementById("countStatusPaid");
    const countStatusPending = document.getElementById("countStatusPending");

    const tabTypeAll = document.getElementById("tabTypeAll");
    const tabTypeStartup = document.getElementById("tabTypeStartup");
    const tabTypeInvestor = document.getElementById("tabTypeInvestor");
    const tabTypeStudent = document.getElementById("tabTypeStudent");
    const countTypeAll = document.getElementById("countTypeAll");
    const countTypeStartup = document.getElementById("countTypeStartup");
    const countTypeInvestor = document.getElementById("countTypeInvestor");
    const countTypeStudent = document.getElementById("countTypeStudent");

    const searchInput = document.getElementById("searchInput");
    const clearSearchBtn = document.getElementById("clearSearchBtn");
    const ticketsTbody = document.getElementById("ticketsTbody");

    // Details Modal Elements
    const detailsDialog = document.getElementById("detailsDialog");
    const detailName = document.getElementById("detailName");
    const detailEmail = document.getElementById("detailEmail");
    const detailStatus = document.getElementById("detailStatus");
    const detailAmount = document.getElementById("detailAmount");
    const detailCompany = document.getElementById("detailCompany");
    const detailRole = document.getElementById("detailRole");
    const detailTickets = document.getElementById("detailTickets");
    const detailQuestionnaire = document.getElementById("detailQuestionnaire");
    const questionnaireSection = document.getElementById("questionnaireSection");
    const detailQCount = document.getElementById("detailQCount");
    const toggleRawJsonBtn = document.getElementById("toggleRawJsonBtn");
    const rawJsonBtnText = document.getElementById("rawJsonBtnText");
    const qRawJsonBox = document.getElementById("qRawJsonBox");
    const detailRegId = document.getElementById("detailRegId");
    const detailStripeSession = document.getElementById("detailStripeSession");
    const detailCreatedAt = document.getElementById("detailCreatedAt");
    const detailUpdatedAt = document.getElementById("detailUpdatedAt");

    // Known Questionnaire Label Map
    const QUESTION_LABELS = {
      business_description: "What does your business do?",
      funding_amount_needed: "Funding Looking to Raise",
      funding_stage: "Funding Stage / Series",
      target_vc_types: "Target VCs to Meet",
      investor_ticket_size: "Typical Ticket Size",
      investor_focus_industries: "Prioritized Sectors & Industries",
      investor_lead_ok: "Open to Lead Investor?",
      investor_global_ok: "Invest in Non-Japan Startups?",
      investor_looking_for_lp: "Looking for LPs?",
      lp_dinner_addon: "LP Dinner Add-on",
    };

    function formatQuestionLabel(key) {
      if (QUESTION_LABELS[key]) return QUESTION_LABELS[key];
      return key
        .replace(/[_-]/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase());
    }

    function formatQuestionValue(key, val) {
      if (val === true || String(val).toLowerCase() === "yes") {
        return `<span class="q-pill q-pill-yes">Yes</span>`;
      }
      if (val === false || String(val).toLowerCase() === "no") {
        return `<span class="q-pill q-pill-no">No</span>`;
      }
      if (key === "funding_stage") {
        return `<span class="q-pill q-pill-stage">${escapeHtml(val)}</span>`;
      }
      if (key === "investor_ticket_size") {
        return `<span class="q-pill q-pill-ticket">${escapeHtml(val)}</span>`;
      }
      if (key === "funding_amount_needed") {
        return `<span class="q-val-highlight">${escapeHtml(val)}</span>`;
      }
      if (key === "investor_focus_industries") {
        const items = Array.isArray(val)
          ? val
          : String(val).split(",").map((s) => s.trim()).filter(Boolean);
        if (items.length) {
          return `<div class="q-tags">${items.map((i) => `<span class="q-tag">${escapeHtml(i)}</span>`).join("")}</div>`;
        }
      }
      if (typeof val === "object" && val !== null) {
        return `<pre class="detail-code-box" style="margin:0;padding:0.4rem;font-size:0.75rem;">${escapeHtml(JSON.stringify(val, null, 2))}</pre>`;
      }
      return `<div class="q-val-text">${escapeHtml(String(val))}</div>`;
    }

    function renderQuestionnaire(q) {
      if (!q || typeof q !== "object") return "";

      const entries = Object.entries(q).filter(
        ([_, v]) => v !== null && v !== undefined && v !== ""
      );
      if (!entries.length) return "";

      const STARTUP_KEYS = [
        "business_description",
        "funding_stage",
        "funding_amount_needed",
        "target_vc_types",
      ];
      const INVESTOR_KEYS = [
        "investor_ticket_size",
        "investor_focus_industries",
        "investor_lead_ok",
        "investor_global_ok",
        "investor_looking_for_lp",
        "lp_dinner_addon",
      ];

      const startupItems = [];
      const investorItems = [];
      const otherItems = [];

      for (const [key, value] of entries) {
        if (STARTUP_KEYS.includes(key)) {
          startupItems.push([key, value]);
        } else if (INVESTOR_KEYS.includes(key)) {
          investorItems.push([key, value]);
        } else {
          otherItems.push([key, value]);
        }
      }

      function renderGroup(title, items) {
        if (!items.length) return "";
        let groupHtml = `
          <div class="q-group">
            <div class="q-group-header">
              <span class="q-group-title">${escapeHtml(title)}</span>
            </div>
            <div class="q-items-grid">
        `;

        for (const [k, v] of items) {
          const label = formatQuestionLabel(k);
          const isFull =
            k === "business_description" ||
            k === "target_vc_types" ||
            k === "investor_focus_industries" ||
            (typeof v === "string" && v.length > 50);

          groupHtml += `
            <div class="q-card ${isFull ? "full-width" : ""}">
              <span class="q-label">${escapeHtml(label)}</span>
              <div class="q-val">${formatQuestionValue(k, v)}</div>
            </div>
          `;
        }

        groupHtml += `</div></div>`;
        return groupHtml;
      }

      let html = "";
      if (startupItems.length) {
        html += renderGroup("Startup Profile", startupItems);
      }
      if (investorItems.length) {
        html += renderGroup("Investor Profile", investorItems);
      }
      if (otherItems.length) {
        html += renderGroup("Additional Responses", otherItems);
      }

      return html;
    }

    // In-memory data
    let registrationsCache = [];
    let currentStatusFilter = "all"; // "all" | "paid" | "pending"
    let currentTypeFilter = "all"; // "all" | "startup" | "investor" | "student"
    let currentSearch = "";

    function getStoredPassword() {
      return sessionStorage.getItem(STORAGE_KEY) || "";
    }

    function getApiUrl(path) {
      const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
      if (isLocal && window.location.port !== "8787") {
        return `http://${window.location.hostname}:8787${path}`;
      }
      return path;
    }

    function escapeHtml(str) {
      return String(str || "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      })[c]);
    }

    function formatRelativeTime(date) {
      const now = new Date();
      const diffMs = now - date;
      const diffSec = Math.floor(diffMs / 1000);
      if (diffSec < 60) return "just now";
      const diffMin = Math.floor(diffSec / 60);
      if (diffMin < 60) return `${diffMin}m ago`;
      const diffHour = Math.floor(diffMin / 60);
      if (diffHour < 24) return `${diffHour}h ago`;
      const diffDay = Math.floor(diffHour / 24);
      if (diffDay < 30) return `${diffDay}d ago`;
      return date.toLocaleDateString("en-US", { month: "short", day: "numeric" });
    }

    function formatAmount(amount, currency = "jpy") {
      const num = Number(amount || 0);
      const code = String(currency || "jpy").toLowerCase();
      if (code === "jpy") {
        return `¥${Math.round(num).toLocaleString("en-US")} JPY`;
      }
      if (code === "usd") {
        return `$${num.toLocaleString("en-US")} USD`;
      }
      if (code === "eur") {
        return `€${num.toLocaleString("en-US")} EUR`;
      }
      return `${num.toLocaleString("en-US")} ${code.toUpperCase()}`;
    }

    function formatTicketsSummary(tickets) {
      if (!tickets) return '<span style="color:rgba(255,255,255,0.35);">—</span>';

      // If array of line items: [{ description, quantity }]
      if (Array.isArray(tickets)) {
        if (!tickets.length) return '<span style="color:rgba(255,255,255,0.35);">—</span>';
        return tickets.map((t) => {
          const name = escapeHtml(t.description || "Ticket");
          const q = Number(t.quantity || 1);
          return `<span class="ticket-tag">${name} <span class="ticket-tag-strong">×${q}</span></span>`;
        }).join(" ");
      }

      // If object of quantities: { startup: 1, investor: 2 }
      if (typeof tickets === "object") {
        const ticketNames = {
          startup: "Startup",
          investor: "Investor",
          student: "Student",
          test_taro: "Test (Taro)",
          lpDinner: "LP Dinner",
        };
        const items = [];
        for (const [key, val] of Object.entries(tickets)) {
          const count = Number(val || 0);
          if (count > 0) {
            const label = ticketNames[key] || key.charAt(0).toUpperCase() + key.slice(1);
            items.push(`<span class="ticket-tag">${label} <span class="ticket-tag-strong">×${count}</span></span>`);
          }
        }
        if (items.length) return items.join(" ");
      }

      return '<span style="color:rgba(255,255,255,0.35);">—</span>';
    }

    function showDashboard() {
      lockView.classList.add("hidden");
      dashboardView.classList.remove("hidden");
      authActions.classList.remove("hidden");
      loadRegistrations();
    }

    function showLock() {
      lockView.classList.remove("hidden");
      dashboardView.classList.add("hidden");
      authActions.classList.add("hidden");
      sessionStorage.removeItem(STORAGE_KEY);
      adminPasswordInput.value = "";
    }

    // Login Form Submit
    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      authError.classList.add("hidden");
      const password = adminPasswordInput.value.trim();

      try {
        const res = await fetch(getApiUrl("/api/admin/verify"), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Authentication failed");
        }

        sessionStorage.setItem(STORAGE_KEY, password);
        showDashboard();
      } catch (err) {
        let msg = err.message || "Invalid password";
        const isLocal = window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";
        if (err.name === "TypeError" && isLocal && window.location.port === "4321") {
          msg = "Cannot connect to Cloudflare Functions on port 8787. Please ensure 'npm run dev:functions' is running.";
        }
        authError.textContent = msg;
        authError.classList.remove("hidden");
      }
    });

    logoutBtn.addEventListener("click", showLock);
    refreshBtn.addEventListener("click", () => loadRegistrations());

    // Load registrations from API
    async function loadRegistrations() {
      const password = getStoredPassword();
      if (!password) return showLock();

      ticketsTbody.innerHTML = `
        <tr><td colspan="7" class="table-empty-cell">Loading registrations...</td></tr>
      `;

      try {
        const res = await fetch(getApiUrl("/api/admin/tickets"), {
          headers: {
            Authorization: `Bearer ${password}`,
            "X-Admin-Password": password,
          },
        });

        if (res.status === 401) {
          return showLock();
        }

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || "Failed to load registrations");
        }

        registrationsCache = data.registrations || [];
        updateMetricsAndFilterCounts();
        renderTable();
      } catch (err) {
        ticketsTbody.innerHTML = `
          <tr><td colspan="7" class="table-empty-cell" style="color:#f87171;">Error: ${escapeHtml(err.message)}</td></tr>
        `;
      }
    }

    function hasTicketType(reg, type) {
      const target = String(type || "").toLowerCase().trim();
      if (!target || target === "all") return true;

      const tickets = reg?.tickets;
      if (Array.isArray(tickets)) {
        const match = tickets.some((t) => {
          const desc = String(t.description || t.name || "").toLowerCase();
          return desc.includes(target) && Number(t.quantity || 1) > 0;
        });
        if (match) return true;
      } else if (tickets && typeof tickets === "object") {
        for (const [key, count] of Object.entries(tickets)) {
          if (key.toLowerCase().includes(target) && Number(count) > 0) {
            return true;
          }
        }
      }

      // Fallback check on questionnaire fields
      const q = reg?.questionnaire;
      if (q && typeof q === "object") {
        if (target === "startup" && (q.funding_stage || q.business_description || q.funding_amount_needed)) {
          return true;
        }
        if (target === "investor" && (q.investor_ticket_size || q.investor_focus_industries || q.investor_lead_ok)) {
          return true;
        }
      }

      return false;
    }

    function updateMetricsAndFilterCounts() {
      const total = registrationsCache.length;
      let paidCount = 0;
      let pendingCount = 0;
      let paidRevenue = 0;

      let startupCount = 0;
      let investorCount = 0;
      let studentCount = 0;

      for (const reg of registrationsCache) {
        const status = (reg.payment_status || "pending").toLowerCase();
        if (status === "paid") {
          paidCount++;
          paidRevenue += Number(reg.total_amount || 0);
        } else if (status === "pending") {
          pendingCount++;
        }

        if (hasTicketType(reg, "startup")) startupCount++;
        if (hasTicketType(reg, "investor")) investorCount++;
        if (hasTicketType(reg, "student")) studentCount++;
      }

      metricTotal.textContent = total.toLocaleString("en-US");
      metricPaid.textContent = paidCount.toLocaleString("en-US");
      metricPending.textContent = pendingCount.toLocaleString("en-US");
      metricRevenue.textContent = `¥${Math.round(paidRevenue).toLocaleString("en-US")}`;

      countStatusAll.textContent = total;
      countStatusPaid.textContent = paidCount;
      countStatusPending.textContent = pendingCount;

      countTypeAll.textContent = total;
      countTypeStartup.textContent = startupCount;
      countTypeInvestor.textContent = investorCount;
      countTypeStudent.textContent = studentCount;
    }

    // Status filter tabs click handlers
    const statusTabs = [tabStatusAll, tabStatusPaid, tabStatusPending];
    statusTabs.forEach((tab) => {
      if (!tab) return;
      tab.addEventListener("click", () => {
        statusTabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        currentStatusFilter = tab.dataset.status;
        renderTable();
      });
    });

    // Ticket type filter tabs click handlers
    const typeTabs = [tabTypeAll, tabTypeStartup, tabTypeInvestor, tabTypeStudent];
    typeTabs.forEach((tab) => {
      if (!tab) return;
      tab.addEventListener("click", () => {
        typeTabs.forEach((t) => t.classList.remove("active"));
        tab.classList.add("active");
        currentTypeFilter = tab.dataset.type;
        renderTable();
      });
    });

    // Search input handler
    searchInput.addEventListener("input", () => {
      currentSearch = searchInput.value.trim().toLowerCase();
      clearSearchBtn.classList.toggle("hidden", !currentSearch);
      renderTable();
    });

    clearSearchBtn.addEventListener("click", () => {
      searchInput.value = "";
      currentSearch = "";
      clearSearchBtn.classList.add("hidden");
      renderTable();
    });

    function getFilteredRegistrations() {
      return registrationsCache.filter((reg) => {
        const status = (reg.payment_status || "pending").toLowerCase();

        // 1. Status Filter
        if (currentStatusFilter === "paid" && status !== "paid") return false;
        if (currentStatusFilter === "pending" && status !== "pending") return false;

        // 2. Ticket Type Filter
        if (currentTypeFilter !== "all" && !hasTicketType(reg, currentTypeFilter)) {
          return false;
        }

        // 3. Search Filter
        if (currentSearch) {
          const name = String(reg.full_name || "").toLowerCase();
          const email = String(reg.email || "").toLowerCase();
          const company = String(reg.company || "").toLowerCase();
          const role = String(reg.role || "").toLowerCase();
          const stripeId = String(reg.stripe_session_id || "").toLowerCase();
          const ticketsText = JSON.stringify(reg.tickets || {}).toLowerCase();
          const qText = JSON.stringify(reg.questionnaire || {}).toLowerCase();

          const matches =
            name.includes(currentSearch) ||
            email.includes(currentSearch) ||
            company.includes(currentSearch) ||
            role.includes(currentSearch) ||
            stripeId.includes(currentSearch) ||
            ticketsText.includes(currentSearch) ||
            qText.includes(currentSearch);

          if (!matches) return false;
        }

        return true;
      });
    }

    function renderTable() {
      const filtered = getFilteredRegistrations();

      if (!filtered.length) {
        let msg = "No registrations match your current filters.";
        if (currentSearch) {
          msg = "No registrations match your search query.";
        }
        ticketsTbody.innerHTML = `<tr><td colspan="7" class="table-empty-cell">${escapeHtml(msg)}</td></tr>`;
        return;
      }

      ticketsTbody.innerHTML = filtered.map((reg) => {
        const status = (reg.payment_status || "pending").toLowerCase();
        let badgeClass = "status-pending";
        let badgeText = "Pending";

        if (status === "paid") {
          badgeClass = "status-paid";
          badgeText = "Paid";
        } else if (status === "failed" || status === "canceled") {
          badgeClass = "status-failed";
          badgeText = status;
        }

        const date = reg.created_at ? new Date(reg.created_at) : null;
        const formattedDate = date
          ? date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
          : "—";
        const relativeDate = date ? formatRelativeTime(date) : "";

        const safeName = escapeHtml(reg.full_name || "Unnamed Attendee");
        const safeEmail = escapeHtml(reg.email || "");
        const safeCompany = escapeHtml(reg.company || "—");
        const safeRole = escapeHtml(reg.role || "");
        const ticketsHtml = formatTicketsSummary(reg.tickets);
        const amountDisplay = formatAmount(reg.total_amount, reg.currency);

        // Questionnaire teaser badge in Company column (no emojis)
        let qTeaserHtml = "";
        const q = reg.questionnaire;
        if (q && typeof q === "object") {
          const hasAny = Object.values(q).some((v) => v !== null && v !== "" && v !== undefined);
          if (hasAny) {
            if (q.funding_stage) {
              qTeaserHtml = `<span class="q-chip q-chip-startup" title="${escapeHtml(q.business_description || 'Startup Profile')}">${escapeHtml(q.funding_stage)}</span>`;
            } else if (q.investor_ticket_size) {
              qTeaserHtml = `<span class="q-chip q-chip-investor" title="${escapeHtml(q.investor_focus_industries || 'Investor Profile')}">${escapeHtml(q.investor_ticket_size)}</span>`;
            } else {
              qTeaserHtml = `<span class="q-chip" title="Questionnaire answered">Q&A</span>`;
            }
          }
        }

        return `
          <tr data-id="${escapeHtml(reg.id)}">
            <td><span class="status-badge ${badgeClass}">${badgeText}</span></td>
            <td>
              <span class="attendee-name">${safeName}</span>
              ${safeEmail ? `<a href="mailto:${safeEmail}" class="attendee-email">${safeEmail}</a>` : ""}
            </td>
            <td>
              <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
                <span class="company-name">${safeCompany}</span>
                ${qTeaserHtml}
              </div>
              ${safeRole ? `<span class="role-name">${safeRole}</span>` : ""}
            </td>
            <td>
              <div class="tickets-summary">${ticketsHtml}</div>
            </td>
            <td class="amount-cell">${escapeHtml(amountDisplay)}</td>
            <td class="date-cell">
              <span>${escapeHtml(formattedDate)}</span>
              ${relativeDate ? `<span class="date-relative">${escapeHtml(relativeDate)}</span>` : ""}
            </td>
            <td style="text-align:right;">
              <button type="button" class="btn btn-ghost btn-sm view-details-btn" data-id="${escapeHtml(reg.id)}" title="View full registration details">
                Details
              </button>
            </td>
          </tr>
        `;
      }).join("");

      // Bind Details buttons
      ticketsTbody.querySelectorAll(".view-details-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const regId = btn.dataset.id;
          const reg = registrationsCache.find((r) => r.id === regId);
          if (reg) openDetailsModal(reg);
        });
      });
    }

    function openDetailsModal(reg) {
      detailName.textContent = reg.full_name || "Unnamed Attendee";
      detailEmail.textContent = reg.email || "No email provided";

      const status = (reg.payment_status || "pending").toLowerCase();
      let badgeClass = status === "paid" ? "status-paid" : "status-pending";
      detailStatus.innerHTML = `<span class="status-badge ${badgeClass}">${status.toUpperCase()}</span>`;

      detailAmount.textContent = formatAmount(reg.total_amount, reg.currency);
      detailCompany.textContent = reg.company || "—";
      detailRole.textContent = reg.role || "—";
      detailTickets.innerHTML = formatTicketsSummary(reg.tickets);

      detailRegId.textContent = reg.id || "—";
      detailStripeSession.textContent = reg.stripe_session_id || "None (pre-checkout or offline)";
      detailCreatedAt.textContent = reg.created_at ? new Date(reg.created_at).toLocaleString() : "—";
      detailUpdatedAt.textContent = reg.updated_at ? new Date(reg.updated_at).toLocaleString() : "—";

      // Questionnaire Responses
      const q = reg.questionnaire;
      const qHtml = renderQuestionnaire(q);
      if (qHtml) {
        questionnaireSection.classList.remove("hidden");
        detailQuestionnaire.innerHTML = qHtml;
        const count = Object.values(q).filter((v) => v !== null && v !== "" && v !== undefined).length;
        detailQCount.textContent = `${count} answered`;
        qRawJsonBox.textContent = JSON.stringify(q, null, 2);
        qRawJsonBox.classList.add("hidden");
        rawJsonBtnText.textContent = "Show Raw JSON";
      } else {
        questionnaireSection.classList.add("hidden");
      }

      detailsDialog.showModal();
    }

    // Toggle Raw JSON
    if (toggleRawJsonBtn) {
      toggleRawJsonBtn.addEventListener("click", () => {
        const isHidden = qRawJsonBox.classList.toggle("hidden");
        rawJsonBtnText.textContent = isHidden ? "Show Raw JSON" : "Hide Raw JSON";
      });
    }

    // Dialog close buttons
    document.querySelectorAll("[data-action='close-dialog']").forEach((btn) => {
      btn.addEventListener("click", () => {
        detailsDialog.close();
      });
    });

    detailsDialog.addEventListener("click", (e) => {
      if (e.target === detailsDialog) {
        detailsDialog.close();
      }
    });

    // CSV Export
    exportCsvBtn.addEventListener("click", () => {
      const records = getFilteredRegistrations();
      if (!records.length) {
        alert("No records to export.");
        return;
      }

      const headers = [
        "Registration ID",
        "Payment Status",
        "Full Name",
        "Email",
        "Company",
        "Role",
        "Total Amount",
        "Currency",
        "Tickets",
        "Stripe Session ID",
        "Created At",
      ];

      const csvRows = [headers.join(",")];

      for (const r of records) {
        const ticketsStr = JSON.stringify(r.tickets || "").replace(/"/g, '""');
        const row = [
          `"${r.id || ""}"`,
          `"${r.payment_status || "pending"}"`,
          `"${(r.full_name || "").replace(/"/g, '""')}"`,
          `"${(r.email || "").replace(/"/g, '""')}"`,
          `"${(r.company || "").replace(/"/g, '""')}"`,
          `"${(r.role || "").replace(/"/g, '""')}"`,
          r.total_amount || 0,
          `"${r.currency || "jpy"}"`,
          `"${ticketsStr}"`,
          `"${r.stripe_session_id || ""}"`,
          `"${r.created_at || ""}"`,
        ];
        csvRows.push(row.join(","));
      }

      const blob = new Blob([csvRows.join("\n")], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `tickets-${currentStatusFilter}-${currentTypeFilter}-${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });

    // Init: Auto check if password already in session
    const saved = getStoredPassword();
    if (saved) {
      showDashboard();
    } else {
      showLock();
    }
  })();
</script>
