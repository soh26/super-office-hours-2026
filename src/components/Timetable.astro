const stageSessions = [
  { column: "stage", start: "10:00", end: "11:30", title: "Pitch Contest Round 1" },
  { column: "stage", start: "11:30", end: "13:00", title: "Pitch Contest Round 2" },
  { column: "stage", start: "13:00", end: "13:30", title: "ReSpark" },
  { column: "stage", start: "13:30", end: "14:00", title: "Deel" },
  { column: "stage", start: "14:00", end: "14:30", title: "Panel Discussions" },
  { column: "stage", start: "14:30", end: "15:30", title: "VC Pitch" },
  { column: "stage", start: "15:30", end: "17:00", title: "Panel Discussions" },
  { column: "stage", start: "17:00", end: "18:00", title: "Pitch Final" },
];

const sessions = [
  ...stageSessions,
  ...meetingSessions,
  { column: "__all__", start: "18:00", end: "21:00", title: "After Party" },
];
---

<section class="section" id="timetable">
  <div class="container">
    <h2 class="section-title">Timetable</h2>

    <TimetableGrid
      columns={timetableColumns}
      timeRows={timeRows}
      sessions={sessions}
      showLogos
    />
  </div>
</section>
