---
import TimetableGrid from "./TimetableGrid.astro";

const timetableColumns = [
  { key: "stage", label: "Stage" },
  { key: "table1", label: "MTG Table 1" },
  { key: "table2", label: "MTG Table 2" },
  { key: "table3", label: "MTG Table 3" },
  { key: "table4", label: "MTG Table 4" },
  { key: "table5", label: "MTG Table 5" },
  { key: "table6", label: "MTG Table 6" },
  { key: "table7", label: "MTG Table 7" },
];

const timeRows = [
