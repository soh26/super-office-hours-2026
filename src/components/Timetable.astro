  { column: "table2", start: "9:00", end: "11:00", title: "Kazuhide Hashida", logo: "/images/logos/investors/oasis.png" },
  { column: "table2", start: "11:00", end: "13:00", title: "René Budeck", logo: "/images/logos/investors/techstars.png" },
  { column: "table4", start: "10:00", end: "11:00", title: "Jordan Fisher", logo: "/images/logos/investors/antler.png" },
