---
interface Props {
  showDebugTickets?: boolean;
}

const { showDebugTickets = false } = Astro.props;
const isDev =
  import.meta.env.DEV ||
  import.meta.env.DEBUG === "true" ||
  import.meta.env.PUBLIC_DEBUG === "true" ||
  (typeof process !== "undefined" && (process.env?.DEBUG === "true" || process.env?.PUBLIC_DEBUG === "true")) ||
  showDebugTickets;
---

<div class="modal-overlay" id="ticket-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal">
    <div class="modal-header">
      <h2 id="modal-title">Buy tickets</h2>
      <button type="button" class="modal-close" id="modal-close" aria-label="Close">×</button>
    </div>

    <!-- Step 1: Select tickets -->
    <div id="step-1">
      {isDev && (
        <div class="ticket-row" data-ticket="test_taro">
          <div class="ticket-info">
            <div class="name">Taro ticket <span style="font-size: 0.75rem; color: var(--accent);">(Debug)</span></div>
            <div class="price">¥50</div>
          </div>
          <div class="qty-controls">
            <button type="button" class="qty-btn" data-action="-" data-ticket="test_taro">−</button>
            <span class="qty-value" id="qty-test_taro">0</span>
            <button type="button" class="qty-btn" data-action="+" data-ticket="test_taro">+</button>
          </div>
        </div>
      )}

      <div class="ticket-row" data-ticket="startup">
        <div class="ticket-info">
          <div class="name">Startup ticket</div>
          <div class="price">¥3,000</div>
        </div>
        <div class="qty-controls">
          <button type="button" class="qty-btn" data-action="-" data-ticket="startup">−</button>
          <span class="qty-value" id="qty-startup">0</span>
          <button type="button" class="qty-btn" data-action="+" data-ticket="startup">+</button>
        </div>
      </div>

      <div class="ticket-row" data-ticket="investor">
        <div class="ticket-info">
          <div class="name">Investor ticket</div>
          <div class="price">¥6,000</div>
        </div>
        <div class="qty-controls">
          <button type="button" class="qty-btn" data-action="-" data-ticket="investor">−</button>
          <span class="qty-value" id="qty-investor">0</span>
          <button type="button" class="qty-btn" data-action="+" data-ticket="investor">+</button>
        </div>
      </div>

      

      <div class="modal-total">
        <span>Total</span>
        <span id="modal-total-value">¥0</span>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="modal-close-2">Cancel</button>
        <button type="button" class="btn btn-primary" id="modal-continue" disabled>
          Continue
        </button>
      </div>
    </div>

    <!-- Step 2: Contact + live SOH questionnaire -->
    <div id="step-2" class="hidden">
      <div id="modal-alert" class="modal-alert modal-alert-error hidden" role="alert">
        <span class="modal-alert-icon" id="modal-alert-icon">⚠️</span>
        <div class="modal-alert-body" id="modal-alert-text"></div>
        <button type="button" class="modal-alert-close" id="modal-alert-close" aria-label="Dismiss notification">&times;</button>
      </div>

      <div class="field">
        <label for="f-email">Email *</label>
        <input type="email" id="f-email" autocomplete="email" placeholder="name@company.com" />
        <span class="field-error-msg" id="f-email-error">Please enter a valid email address</span>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="f-first">First name *</label>
          <input type="text" id="f-first" autocomplete="given-name" placeholder="First name" />
          <span class="field-error-msg" id="f-first-error">First name is required</span>
        </div>
        <div class="field">
          <label for="f-last">Last name *</label>
          <input type="text" id="f-last" autocomplete="family-name" placeholder="Last name" />
          <span class="field-error-msg" id="f-last-error">Last name is required</span>
        </div>
      </div>
      <div class="field">
        <label for="f-company">Company *</label>
        <input type="text" id="f-company" autocomplete="organization" placeholder="Company or Fund name" />
        <span class="field-error-msg" id="f-company-error">Company name is required</span>
      </div>
      <div class="field">
        <label for="f-title">Title / role</label>
        <input type="text" id="f-title" placeholder="Founder, Partner, etc." />
      </div>

      <div id="ttm-startup-extra" class="hidden">
        <div class="cond-title">For Startups</div>
        <div class="field">
          <label>What does your business do?</label>
          <input id="f-business-description" />
        </div>
        <div class="field">
          <label>How much funding are you looking to raise?</label>
          <input id="f-funding-amount" />
        </div>
        <div class="field">
          <label>Funding stage / Series</label>
          <select id="f-funding-stage">
            <option value="">Select...</option>
            <option>Pre-seed</option>
            <option>Seed</option>
            <option>Series A</option>
            <option>Series B</option>
            <option>Series C+</option>
          </select>
        </div>
        <div class="field">
          <label>What kind of VCs do you want to meet?</label>
          <input id="f-target-vc" />
        </div>
      </div>

      <div id="ttm-investor-extra" class="hidden">
        <div class="cond-title">For Investors</div>
        <div class="field">
          <label>Typical ticket size</label>
          <select id="f-investor-ticket-size">
            <option value="">Select...</option>
            <option>&lt; ¥5M</option>
            <option>¥5M – ¥20M</option>
            <option>¥20M – ¥50M</option>
            <option>¥50M+</option>
          </select>
        </div>
        <div class="field">
          <label>Which industries/sectors do you prioritize?</label>
          <div class="chips" id="chips-investor-sectors">
            <button type="button" class="chip" data-val="All sectors">All sectors</button>
            <button type="button" class="chip" data-val="Deep Tech / AI">Deep Tech / AI</button>
            <button type="button" class="chip" data-val="Fintech">Fintech</button>
            <button type="button" class="chip" data-val="SaaS / B2B Software">SaaS / B2B Software</button>
            <button type="button" class="chip" data-val="Consumer / E-commerce">Consumer / E-commerce</button>
            <button type="button" class="chip" data-val="Biotech / Healthtech">Biotech / Healthtech</button>
            <button type="button" class="chip" data-val="Climate / Sustainability">Climate / Sustainability</button>
            <button type="button" class="chip" data-val="Gaming / Entertainment">Gaming / Entertainment</button>
            <button type="button" class="chip other-chip" data-val="Other">Other</button>
          </div>
          <input id="chips-investor-sectors-other" class="hidden" placeholder="Type your sector..." style="margin-top:0.5rem" />
        </div>
        <div class="field">
          <label>Are you open to being lead investor on a deal?</label>
          <div class="radio-row" data-name="invlead"><span>Yes</span><span>No</span></div>
        </div>
        <div class="field">
          <label>Do you invest in foreign (non-Japan) startups?</label>
          <div class="radio-row" data-name="invglobal"><span>Yes</span><span>No</span></div>
        </div>
        <div class="field">
          <label>Are you looking for LPs?</label>
          <div class="radio-row" data-name="invlookinglp"><span>Yes</span><span>No</span></div>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" id="modal-back">Back</button>
        <button type="button" class="btn btn-primary" id="modal-pay">
          Proceed to payment
        </button>
      </div>
    </div>

    <!-- Step 3: Confirmation placeholder -->
    <div id="step-3" class="hidden" style="text-align: center; padding: 1.5rem 0;">
      <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">✓</div>
      <h3 style="margin-bottom: 0.5rem;">You're in!</h3>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
        Check your email for the confirmation and QR code.
      </p>
      <button type="button" class="btn btn-primary" id="modal-done">Done</button>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const hasDebugRow = !!document.querySelector('.ticket-row[data-ticket="test_taro"]');
  const isDebug =
    import.meta.env.DEV ||
    import.meta.env.DEBUG === "true" ||
    import.meta.env.PUBLIC_DEBUG === "true" ||
    hasDebugRow ||
    window.ENABLE_DEBUG_TICKETS === true ||
    location.pathname.startsWith("/debug");

  const PRICES = {
    ...(isDebug ? { test_taro: 50 } : {}),
    startup: 3000,
    investor: 6000,
    student: 1000,
    
  };
  const TICKET_KEYS = Object.keys(PRICES).filter((k) => k !== "lpDinner");

  let qty = Object.fromEntries(TICKET_KEYS.map((k) => [k, 0]));
  let lpDinner = false;

  const modal = document.getElementById("ticket-modal");
  const totalEl = document.getElementById("modal-total-value");
  const continueBtn = document.getElementById("modal-continue");
  const lpRow = document.getElementById("lp-dinner-row");
  const lpToggle = document.getElementById("lp-dinner-toggle");
  const modalAlert = document.getElementById("modal-alert");
  const modalAlertText = document.getElementById("modal-alert-text");
  const modalAlertIcon = document.getElementById("modal-alert-icon");
  const modalAlertClose = document.getElementById("modal-alert-close");

  function formatYen(n) {
    return "¥" + Number(n).toLocaleString();
  }

  function showModalAlert(message, type = "error") {
    if (!modalAlert || !modalAlertText) return;
    modalAlert.className = `modal-alert modal-alert-${type}`;
    if (modalAlertIcon) {
      modalAlertIcon.textContent = type === "error" ? "⚠️" : type === "warning" ? "ℹ️" : "✓";
    }
    modalAlertText.textContent = message;
    modalAlert.classList.remove("hidden");
  }

  function hideModalAlert() {
    if (modalAlert) modalAlert.classList.add("hidden");
  }

  modalAlertClose?.addEventListener("click", hideModalAlert);

  function setFieldError(id, msg) {
    const el = document.getElementById(id);
    const errEl = document.getElementById(id + "-error");
    if (el) el.classList.add("field-invalid");
    if (errEl) {
      if (msg) errEl.textContent = msg;
      errEl.classList.add("visible");
    }
  }

  function clearFieldError(id) {
    const el = document.getElementById(id);
    const errEl = document.getElementById(id + "-error");
    if (el) el.classList.remove("field-invalid");
    if (errEl) errEl.classList.remove("visible");
  }

  function clearAllFieldErrors() {
    ["f-email", "f-first", "f-last", "f-company"].forEach(clearFieldError);
    hideModalAlert();
  }

  // Live validation listeners to clear errors on user input
  ["f-email", "f-first", "f-last", "f-company"].forEach((id) => {
    const input = document.getElementById(id);
    if (input) {
      input.addEventListener("input", () => {
        clearFieldError(id);
        if (modalAlert && !modalAlert.classList.contains("hidden")) {
          const email = val("f-email");
          const first = val("f-first");
          const last = val("f-last");
          const company = val("f-company");
          if (email && first && last && company) hideModalAlert();
        }
      });
    }
  });

  function validateStep2() {
    clearAllFieldErrors();
    let isValid = true;
    let firstInvalidEl = null;

    const email = val("f-email");
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email) {
      setFieldError("f-email", "Email is required");
      isValid = false;
      firstInvalidEl = firstInvalidEl || document.getElementById("f-email");
    } else if (!emailRegex.test(email)) {
      setFieldError("f-email", "Please enter a valid email address (e.g. you@company.com)");
      isValid = false;
      firstInvalidEl = firstInvalidEl || document.getElementById("f-email");
    }

    if (!val("f-first")) {
      setFieldError("f-first", "First name is required");
      isValid = false;
      firstInvalidEl = firstInvalidEl || document.getElementById("f-first");
    }

    if (!val("f-last")) {
      setFieldError("f-last", "Last name is required");
      isValid = false;
      firstInvalidEl = firstInvalidEl || document.getElementById("f-last");
    }

    if (!val("f-company")) {
      setFieldError("f-company", "Company name is required");
      isValid = false;
      firstInvalidEl = firstInvalidEl || document.getElementById("f-company");
    }

    if (!isValid) {
      showModalAlert("Please fill in all required fields marked in red.", "error");
      if (firstInvalidEl) firstInvalidEl.focus();
      const modalBox = modal?.querySelector(".modal");
      if (modalBox) {
        modalBox.classList.add("shake");
        setTimeout(() => modalBox.classList.remove("shake"), 400);
      }
    }

    return isValid;
  }

  function updateUI() {
    document.querySelectorAll(".ticket-row[data-ticket]").forEach((row) => {
      const key = row.dataset.ticket;
      const qtyEl = document.getElementById("qty-" + key);
      if (qtyEl) qtyEl.textContent = String(qty[key] ?? 0);
      row.classList.toggle("picked", !!key && qty[key] > 0);
    });

    if (lpRow) {
      lpRow.classList.toggle("hidden", qty.investor === 0);
      if (qty.investor === 0) lpDinner = false;
    }
    if (lpToggle) {
      lpToggle.textContent = lpDinner ? "Remove" : "Add";
      if (lpRow) lpRow.classList.toggle("picked", lpDinner);
    }

    const total =
      TICKET_KEYS.reduce((sum, key) => sum + (qty[key] || 0) * (PRICES[key] || 0), 0) +
      (lpDinner && qty.investor > 0 ? PRICES.lpDinner : 0);

    if (totalEl) totalEl.textContent = formatYen(total);
    if (continueBtn) continueBtn.disabled = total <= 0;
  }

  function openModal() {
    if (modal) modal.classList.add("open");
    document.body.style.overflow = "hidden";
    showStep(1);
  }

  function closeModal() {
    if (modal) modal.classList.remove("open");
    document.body.style.overflow = "";
    hideModalAlert();
  }

  function showStep(step) {
    document.getElementById("step-1")?.classList.toggle("hidden", step !== 1);
    document.getElementById("step-2")?.classList.toggle("hidden", step !== 2);
    document.getElementById("step-3")?.classList.toggle("hidden", step !== 3);
    document.getElementById("ttm-startup-extra")?.classList.toggle("hidden", (qty.startup || 0) <= 0);
    document.getElementById("ttm-investor-extra")?.classList.toggle("hidden", (qty.investor || 0) <= 0);
    hideModalAlert();
  }

  function val(id) {
    return (document.getElementById(id)?.value || "").trim();
  }

  function radioVal(name) {
    const sel = document.querySelector(`.radio-row[data-name="${name}"] span.sel`);
    return sel ? sel.textContent.trim() : "";
  }

  function chipVals(id) {
    const root = document.getElementById(id);
    if (!root) return [];
    return [...root.querySelectorAll(".chip.sel")].map((el) => {
      if (el.classList.contains("other-chip")) {
        return val(id + "-other") || "Other";
      }
      return el.getAttribute("data-val");
    });
  }

  function collectQuestionnaire() {
    const q = {};
    if (qty.startup > 0) {
      q.business_description = val("f-business-description");
      q.funding_amount_needed = val("f-funding-amount");
      q.funding_stage = val("f-funding-stage");
      q.target_vc_types = val("f-target-vc");
    }
    if (qty.investor > 0) {
      q.investor_ticket_size = val("f-investor-ticket-size");
      q.investor_focus_industries = chipVals("chips-investor-sectors").join(", ");
      q.investor_lead_ok = radioVal("invlead");
      q.investor_global_ok = radioVal("invglobal");
      q.investor_looking_for_lp = radioVal("invlookinglp");
      q.lp_dinner_addon = lpDinner;
    }
    return q;
  }

  window.addEventListener("open-ticket-modal", openModal);

  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  document.getElementById("modal-close-2")?.addEventListener("click", closeModal);
  document.getElementById("modal-done")?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("open")) {
      closeModal();
    }
  });

  document.querySelectorAll(".qty-btn[data-action]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const action = btn.dataset.action;
      const ticket = btn.dataset.ticket;
      if (!ticket || !(ticket in qty)) return;

      if (action === "+") qty[ticket]++;
      if (action === "-" && qty[ticket] > 0) qty[ticket]--;
      updateUI();
    });
  });

  lpToggle?.addEventListener("click", () => {
    lpDinner = !lpDinner;
    updateUI();
  });

  document.getElementById("modal-continue")?.addEventListener("click", () => {
    showStep(2);
  });

  document.getElementById("modal-back")?.addEventListener("click", () => {
    showStep(1);
  });

  document.querySelectorAll(".chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      chip.classList.toggle("sel");
      if (chip.classList.contains("other-chip")) {
        document.getElementById("chips-investor-sectors-other")?.classList.toggle("hidden", !chip.classList.contains("sel"));
      }
    });
  });

  document.querySelectorAll(".radio-row span").forEach((span) => {
    span.addEventListener("click", () => {
      span.parentElement?.querySelectorAll("span").forEach((s) => s.classList.remove("sel"));
      span.classList.add("sel");
    });
  });

  document.getElementById("modal-pay")?.addEventListener("click", async () => {
    if (!validateStep2()) return;

    const email = val("f-email");
    const name = (val("f-first") + " " + val("f-last")).trim();
    const company = val("f-company");
    const role = val("f-title");
    const payBtn = document.getElementById("modal-pay");

    if (!payBtn) return;
    payBtn.disabled = true;
    payBtn.innerHTML = '<span class="spinner" style="margin-right: 0.5rem;"></span> Preparing checkout…';

    try {
      if (!navigator.onLine) {
        throw new Error("You appear to be offline. Please check your internet connection.");
      }

      const checkoutApi =
        window.STRIPE_API_URL ||
        (location.hostname === "localhost"
          ? "http://localhost:8787/api/create-checkout"
          : "/api/create-checkout");

      const registrationId = crypto.randomUUID();
      const tickets = { ...qty };
      const questionnaire = collectQuestionnaire();

      const res = await fetch(checkoutApi, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          registrationId,
          qty: tickets,
          email,
          name,
          company,
          role,
          questionnaire,
          lpDinner,
        }),
        signal: AbortSignal.timeout(15000),
      });

      let data;
      try {
        data = await res.json();
      } catch {
        throw new Error("Unable to parse server response. Please try again.");
      }

      if (!res.ok || !data?.url) {
        throw new Error(data?.error || `Checkout failed (${res.status}). Please try again.`);
      }

      window.location.href = data.url;
    } catch (err) {
      console.error("Checkout initiation error:", err);
      let userMsg = err.message || "Could not connect to payment processor. Please try again.";
      if (err.name === "TimeoutError" || err.name === "AbortError") {
        userMsg = "Payment request timed out. Please check your connection and try again.";
      }
      showModalAlert(userMsg, "error");
      if (window.showToast) {
        window.showToast(userMsg, "error");
      }
      payBtn.disabled = false;
      payBtn.textContent = "Proceed to payment";
    }
  });

  updateUI();

  // URL Parameters Handling on Load
  const searchParams = new URLSearchParams(location.search);
  if (searchParams.get("paid") === "1") {
    openModal();
    showStep(3);
    if (window.showToast) {
      window.showToast("Payment successful! Confirmation email is on its way.", "success");
    }
    history.replaceState({}, "", location.pathname);
  } else if (searchParams.get("canceled") === "1") {
    if (window.showToast) {
      window.showToast("Checkout was canceled. Your ticket selection is still saved.", "warning");
    }
    history.replaceState({}, "", location.pathname);
  } else if (searchParams.get("error")) {
    const errorMsg = searchParams.get("error");
    if (window.showToast) {
      window.showToast(decodeURIComponent(errorMsg), "error");
    }
    history.replaceState({}, "", location.pathname);
  }
</script>
