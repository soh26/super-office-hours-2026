---
const startups = [
  { name: "Jobtales", src: "/images/logos/startups/jobtales.png" },
  { name: "Refcome", src: "/images/logos/startups/refcome.png" },
  { name: "Atlas", src: "/images/logos/startups/atlas.png" },
  { name: "LOOQ", src: "/images/logos/startups/looq.png" },
  { name: "Respark", src: "/images/logos/startups/respark.svg" },
  { name: "TECETEME", src: "/images/logos/startups/tecteme.png" },
  { name: "Datailo", src: "/images/logos/startups/datailo.png" },
  { name: "Suparanku", src: "/images/logos/startups/suparanku.png" },
];
const investors = [
  { name: "Antler", src: "/images/logos/investors/antler.png" },
  { name: "Archetype", src: "/images/logos/investors/archetype.png" },
  { name: "DG", src: "/images/logos/investors/dg.png" },
  { name: "Great Wave Ventures", src: "/images/logos/investors/greatwave.png" },
  { name: "GHOVC", src: "/images/logos/investors/ghovc.png" },
  { name: "Headline", src: "/images/logos/investors/headline.png" },
  { name: "Niu Ventures", src: "/images/logos/investors/niuventures.png" },
  { name: "Partners Fund", src: "/images/logos/investors/partnersfund.png" },
  { name: "Shiza Ventures", src: "/images/logos/investors/shizaventures.png" },
];
---

<section class="section" id="who">
  <div class="container">
    <h2 class="section-title">Who's joining?</h2>

    <h3 class="who-label">Startups</h3>
    <div class="who-grid">
      {startups.map((c) => (
        <div class="who-tile">
          <img src={c.src} alt={c.name} />
        </div>
      ))}
    </div>

    <h3 class="who-label">Investors</h3>
    <div class="who-grid">
      {investors.map((c) => (
        <div class="who-tile">
          <img src={c.src} alt={c.name} />
        </div>
      ))}
    </div>
  </div>
</section>