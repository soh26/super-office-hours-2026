---

<section class="section" id="who">
  <div class="container">
    <h2 class="section-title">Who's joining?</h2>

    <h3 class="who-label">Startups</h3>
    <div class="who-grid">
      {startups.map((c) => (
        <a
          class="who-tile"
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
          title={c.fullName}
          aria-label={c.fullName}
        >
          <img src={c.src} alt={c.fullName} />
        </a>
      ))}
    </div>

    <h3 class="who-label">Investors</h3>
    <div class="who-grid">
      {investors.map((c) => (
        <a
          class="who-tile"
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
          title={c.fullName}
          aria-label={c.fullName}
        >
          <img src={c.src} alt={c.fullName} />
        </a>
      ))}
    </div>
  </div>
</section>