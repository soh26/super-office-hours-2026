---

<section class="section" id="tickets">
  <div class="container">
    <h2 class="section-title">Tickets</h2>

    <div class="ticket-cards">
      <div class="ticket-card">
        <div style="font-size: 0.85rem; color: var(--text-muted);">Startup</div>
        <div class="price">¥2,500</div>
        <ul>
          <li>Full event access</li>
          <li>Investor discussions</li>
          <li>Pitch opportunity</li>
          <li>Tailored matchmaking</li>
        </ul>
        <button type="button" class="btn btn-secondary open-modal-btn" style="width: 100%;">
          Get startup ticket
        </button>
      </div>

      <div class="ticket-card featured">
        <div style="font-size: 0.85rem; color: var(--accent);">Investor</div>
        <div class="price">¥5,000</div>
        <ul>
          <li>Full event access</li>
          <li>1:3 investor-to-startup ratio</li>
          <li>15 qualified startup slots</li>
          <li>LP / GP introductions</li>
        </ul>
        <button type="button" class="btn btn-primary open-modal-btn" style="width: 100%;">
          Get investor ticket
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".open-modal-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("open-ticket-modal"));
    });
  });
</script>
