---
---

<section class="hero">
  <div class="container">
    <p class="hero-badge">
      By
      <img
        class="hero-badge-logo"
        src="/images/takeoff-tokyo-logo.png"
        alt="Takeoff Tokyo"
      />
      · Asia's flagship startup conference, since 2023
    </p>

    <h1 class="hero-title">SUPER OFFICE<br />HOURS</h1>

    <p class="hero-meta">
      September 25, 2026 · Dragon Gate, Shibuya, Tokyo
    </p>

    <div class="hero-actions">
      <button type="button" class="btn btn-primary" id="hero-buy-btn">
        Buy tickets
      </button>
      <a href="#format" class="btn btn-secondary">See the format</a>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="stat-value">50</div>
        <div class="stat-label">investors</div>
      </div>
      <div class="stat">
        <div class="stat-value">200</div>
        <div class="stat-label">startups</div>
      </div>
      <div class="stat">
        <div class="stat-value">400</div>
        <div class="stat-label">meetings</div>
      </div>
      <div class="stat">
        <div class="stat-value">3 yrs</div>
        <div class="stat-label">Takeoff Tokyo</div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById("hero-buy-btn")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("open-ticket-modal"));
  });
</script>
